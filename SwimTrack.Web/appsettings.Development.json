{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=SwimTrack;Trusted_Connection=True;Encrypt=False;"
  },
  "IdentitySettings": {
    "SignIn": {
      "RequireConfirmedAccount": false
    },
    "Password": {
      "RequiredLength": 4,
      "RequireDigit": false,
      "RequireNonAlphanumeric": false,
      "RequireUppercase": false,
      "RequireLowercase": false,
      "RequiredUniqueChars": 1
    },
    "User": {
      "RequireUniqueEmail": true
    }
  }
}