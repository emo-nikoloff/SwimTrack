@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<main class="container page-content">
    <div class="auth-container">
        <form id="registerForm" class="card" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div>
                <p class="eyebrow-heading">Start your journey</p>
                <h1 style="font-size:40px;margin-top:4px">Create your account</h1>
            </div>

            <div class="lane-rope-divider"></div>

            <div asp-validation-summary="ModelOnly" class="field-validation-error" role="alert"></div>

            <div class="form-field">
                <label asp-for="Input.Email">Email address</label>
                <input asp-for="Input.Email" type="email" autocomplete="username" placeholder="name@example.com" required />
                <span asp-validation-for="Input.Email" class="field-validation-error"></span>
            </div>

            <div class="form-field">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" type="password" autocomplete="new-password" placeholder="••••••••" required />
                <span asp-validation-for="Input.Password" class="field-validation-error"></span>
            </div>

            <div class="form-field">
                <label asp-for="Input.ConfirmPassword">Confirm password</label>
                <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" placeholder="••••••••" required />
                <span asp-validation-for="Input.ConfirmPassword" class="field-validation-error"></span>
            </div>

            <div class="stack" style="gap:14px;margin-top:6px">
                <button id="registerSubmit" type="submit" class="button button--primary" style="width:100%">Create account</button>
                <p class="text-muted text-center" style="font-size:15px;margin:0">
                    Already registered?
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" style="color:var(--color-teal);font-weight:700;text-decoration:none">Log in</a>
                </p>
            </div>
        </form>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
