@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<main class="container page-content">
    <div class="auth-container">
        <form class="card" id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div>
                <p class="eyebrow-heading">Start your journey</p>
                <h1 class="auth-page-title">Create your account</h1>
            </div>

            <div class="lane-rope-divider"></div>

            <div class="field-validation-error" asp-validation-summary="ModelOnly" role="alert"></div>

            <div class="form-field">
                <label asp-for="Input.Email">Email address</label>
                <input asp-for="Input.Email" type="email" autocomplete="username" placeholder="name@example.com" required />
                <span class="field-validation-error" asp-validation-for="Input.Email"></span>
            </div>

            <div class="form-field">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" type="password" autocomplete="new-password" placeholder="••••••••" required />
                <span class="field-validation-error" asp-validation-for="Input.Password"></span>
            </div>

            <div class="form-field">
                <label asp-for="Input.ConfirmPassword">Confirm password</label>
                <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" placeholder="••••••••" required />
                <span class="field-validation-error" asp-validation-for="Input.ConfirmPassword"></span>
            </div>

            <div class="stack auth-form-actions">
                <button class="button button--primary button--full-width" id="registerSubmit" type="submit">Create account</button>
                <p class="text-muted text-center auth-form-footer">
                    Already registered?
                    <a class="auth-link" asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
                </p>
            </div>
        </form>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
