@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<main class="container page-content">
    <div class="auth-container">
        <form class="card" id="account" method="post">
            <div>
                <p class="eyebrow-heading">Welcome back</p>
                <h1 class="auth-page-title">Log in to SwimTrack</h1>
            </div>

            <div class="lane-rope-divider"></div>

            <div class="field-validation-error" asp-validation-summary="ModelOnly" role="alert"></div>

            <div class="form-field">
                <label asp-for="Input.Email">Email address</label>
                <input asp-for="Input.Email" type="email" autocomplete="username" placeholder="name@example.com" required />
                <span class="field-validation-error" asp-validation-for="Input.Email"></span>
            </div>

            <div class="form-field">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" type="password" autocomplete="current-password" placeholder="••••••••" required />
                <span class="field-validation-error" asp-validation-for="Input.Password"></span>
            </div>

            <div class="form-checkbox-row">
                <input asp-for="Input.RememberMe" type="checkbox" id="RememberMe" />
                <label for="RememberMe">Remember this browser</label>
            </div>

            <div class="stack auth-form-actions">
                <button class="button button--primary button--full-width" id="login-submit" type="submit">Log in</button>
                <p class="text-muted text-center auth-form-footer">
                    New to SwimTrack?
                    <a class="auth-link" asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register here</a>
                </p>
            </div>
        </form>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
