@model ErrorViewModel
@{
    ViewData["Title"] = "Error 400";
}

<main>
    <section class="container hero-section">
        <div class="stack">
            <p class="eyebrow-heading error-eyebrow">Error 400 · False start</p>
            <div class="error-code" aria-hidden="true">4<partial name="_ErrorBuoyPartial" /><partial name="_ErrorBuoyPartial" /></div>
            <h1 class="error-title">That was a false start.</h1>
            <p class="text-lead">We couldn’t make sense of that request – a link or a form value didn’t look right. Take your marks and try again.</p>
            <div class="flex-row">
                <a class="button button--primary"
                   asp-controller="Home"
                   asp-action="Index"
                   onclick="if (window.history.length > 1) { window.history.back(); return false; }">
                    Go back
                </a>
                <a class="button" asp-controller="TrainingPlan" asp-action="All">Back to plans</a>
            </div>
            @if (Model.ShowRequestId)
            {
                <div class="lane-rope-divider"></div>
                <div class="form-field">
                    <label>Request ID</label>
                    <code class="error-request-id">@Model.RequestId</code>
                </div>
            }
        </div>
