@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<main class="container page-content">
    <div class="auth-container error-container">
        <div class="card">
            <p class="eyebrow-heading error-eyebrow">Error</p>
            <h1 class="error-title">Something went wrong</h1>
            <div class="lane-rope-divider"></div>
            <p class="text-muted">An error occurred while processing your request.</p>

            @if (Model.ShowRequestId)
            {
                <div class="form-field">
                    <label>Request ID</label>
                    <code class="error-request-id">@Model.RequestId</code>
                </div>
            }

            <div class="flex-row error-actions">
                <a class="button button--primary" asp-controller="Home" asp-action="Index">Back to Home</a>
            </div>
        </div>
    </div>
</main>
