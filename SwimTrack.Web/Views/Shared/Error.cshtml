@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<main class="wrap pg">
    <div class="auth-box" style="max-width:600px">
        <div class="card">
            <p class="eb" style="color:var(--cd)">Error</p>
            <h1 style="font-size:36px">Something went wrong</h1>
            <div class="rope"></div>
            <p class="mut">An error occurred while processing your request.</p>

            @if (Model.ShowRequestId)
            {
                <div class="fld">
                    <label>Request ID</label>
                    <code style="padding:8px 12px;background:var(--tile);border-radius:8px;border:1px solid var(--line);font-size:14px">@Model.RequestId</code>
                </div>
            }

            <div class="row" style="margin-top:12px">
                <a class="btn go" asp-controller="Home" asp-action="Index">Back to Home</a>
            </div>
        </div>
    </div>
</main>
