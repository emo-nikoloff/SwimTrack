<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SwimTrack - @(ViewData["Title"] ?? "Swim training journal")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@700;800&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SwimTrack.Web.styles.css" asp-append-version="true" />
</head>

<body>
    <div class="app">
        <header class="nav">
            <div class="wrap">
                <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg width="30" height="30" viewBox="0 0 32 32" fill="none" stroke="#3DD9D0" stroke-width="3" stroke-linecap="round" aria-hidden="true">
                        <path d="M3 11c4-5 6 5 10 0s6 5 10 0 5 2 6 1M3 22c4-5 6 5 10 0s6 5 10 0 5 2 6 1"></path>
                    </svg>
                    SwimTrack
                </a>
                <nav aria-label="Main">
                    <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <a asp-area="" asp-controller="TrainingPlan" asp-action="All">Plans</a>
                        <a asp-area="" asp-controller="TrainingPlan" asp-action="Create">New plan</a>
                    }
                </nav>
                <div class="me">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </header>

        @RenderBody()

        <footer class="wrap foot">
            <small>&copy; @DateTime.Today.Year – SwimTrack</small>
        </footer>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
