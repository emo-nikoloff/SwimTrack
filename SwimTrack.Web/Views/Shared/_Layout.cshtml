<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SwimTrack - @(ViewData["Title"] ?? "Swim training journal")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@700;800&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css" integrity="sha512-6S2HWzVFxruDlZxI3sXOZZ4/eJ8AcxkQH1+JjSe/ONCEqR9L4Ysq5JdT5ipqtzU7WHalNwzwBv+iE51gNHJNqQ==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SwimTrack.Web.styles.css" asp-append-version="true" />
</head>

<body>
    <partial name="_NotificationsPartial" />
    <div class="app">
        <header class="navbar">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg width="30" height="30" viewBox="0 0 32 32" fill="none" stroke="#3DD9D0" stroke-width="3" stroke-linecap="round" aria-hidden="true">
                        <path d="M3 11c4-5 6 5 10 0s6 5 10 0 5 2 6 1M3 22c4-5 6 5 10 0s6 5 10 0 5 2 6 1"></path>
                    </svg>
                    SwimTrack
                </a>
                <nav class="navbar-nav" aria-label="Main">
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <a asp-area="" asp-controller="TrainingPlan" asp-action="All">Plans</a>
                        <a asp-area="" asp-controller="TrainingPlan" asp-action="Create">New plan</a>
                        <a asp-area="" asp-controller="TrainingGoal" asp-action="All">Goals</a>
                        <a asp-area="" asp-controller="SwimmingPool" asp-action="All">Pools</a>

                        if (User.IsInRole(Admin))
                        {
                            <a asp-area="Admin" asp-controller="Home" asp-action="Index">Admin</a>
                        }
                    }
                    else
                    {
                        <a asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    }
                </nav>
                <div class="navbar-user">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </header>

        @RenderBody()

        <footer class="container app-footer">
            <small>&copy; @DateTime.Today.Year – SwimTrack</small>
        </footer>
    </div>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js" integrity="sha512-lbwH47l/tPXJYG9AcFNoJaTMhGvYWhVM9YI43CT+uteTRRaiLCui8snIgyAN8XWgNjNhCqlAUdzZptso6OCoFQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
