@model WorkoutInputModel

@{
    bool isReadOnly = Model.Status != WorkoutStatus.Planned;
}

<input asp-for="Id" type="hidden" />
<input asp-for="Status" type="hidden" />

<div class="grid-3-columns">
    <div class="form-field">
        <label asp-for="Date">Date</label>
        <input asp-for="Date" type="date" readonly="@(isReadOnly ? "readonly" : null)" />
        <span class="field-validation-error" asp-validation-for="Date"></span>
    </div>

    <div class="form-field">
        <label asp-for="PlannedDistance">Distance</label>
        <div class="input-unit-wrapper">
            <input asp-for="PlannedDistance" type="number" min="50" max="20000" step="50" readonly="@(isReadOnly ? "readonly" : null)" />
            <span>m</span>
        </div>
        <span class="field-validation-error" asp-validation-for="PlannedDistance"></span>
    </div>

    <div class="form-field">
        <label asp-for="PlannedDuration">Duration</label>
        <div class="input-unit-wrapper">
            <input asp-for="PlannedDuration" type="number" min="1" max="600" readonly="@(isReadOnly ? "readonly" : null)" />
            <span>min</span>
        </div>
        <span class="field-validation-error" asp-validation-for="PlannedDuration"></span>
    </div>
</div>

<div class="form-field">
    <label asp-for="Notes">Notes</label>
    <textarea asp-for="Notes" rows="2" placeholder="Sets, drills, technique focus..."></textarea>
    <span class="field-validation-error" asp-validation-for="Notes"></span>
</div>
