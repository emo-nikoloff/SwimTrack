@model WorkoutInputModel

@{
    bool isReadOnly = Model.Status != WorkoutStatus.Planned;
}

<input asp-for="Id" type="hidden" />
<input asp-for="Status" type="hidden" />

<div class="g3">
    <div class="fld">
        <label asp-for="Date">Date</label>
        <input asp-for="Date" type="date" readonly="@(isReadOnly ? "readonly" : null)" style="@(isReadOnly ? "background:var(--tile);" : null)" />
        <span asp-validation-for="Date" class="er"></span>
    </div>

    <div class="fld">
        <label asp-for="PlannedDistance">Distance</label>
        <div class="u">
            <input asp-for="PlannedDistance" type="number" min="1" max="20000" readonly="@(isReadOnly ? "readonly" : null)" style="@(isReadOnly ? "background:var(--tile);" : null)" />
            <span>m</span>
        </div>
        <span asp-validation-for="PlannedDistance" class="er"></span>
    </div>

    <div class="fld">
        <label asp-for="PlannedDuration">Duration</label>
        <div class="u">
            <input asp-for="PlannedDuration" type="number" min="1" max="600" readonly="@(isReadOnly ? "readonly" : null)" style="@(isReadOnly ? "background:var(--tile);" : null)" />
            <span>min</span>
        </div>
        <span asp-validation-for="PlannedDuration" class="er"></span>
    </div>
</div>

<div class="fld">
    <label asp-for="Notes">Notes</label>
    <textarea asp-for="Notes" rows="2" placeholder="Sets, drills, technique focus..."></textarea>
    <span asp-validation-for="Notes" class="er"></span>
</div>
