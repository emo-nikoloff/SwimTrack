@model WorkoutViewModel

@{
    string badgeClass = Model.Status switch
    {
        WorkoutStatus.Completed => "text-bg-success",
        WorkoutStatus.Skipped => "text-bg-warning",
        _ => "text-bg-primary"
    };
}

<div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <h3 class="h4 mb-0">@Model.Date.ToString(DateTimeFormat)</h3>
    <span class="badge @badgeClass">@Model.Status</span>
</div>

<dl class="row mb-4">
    <dt class="col-7">Planned distance</dt>
    <dd class="col-5 text-end">@Model.PlannedDistance m</dd>
    <dt class="col-7">Planned duration</dt>
    <dd class="col-5 text-end">@Model.PlannedDuration min</dd>
</dl>

<h4 class="h6">Planned notes</h4>
@if (string.IsNullOrWhiteSpace(Model.Notes))
{
    <p class="text-muted mb-0">No notes.</p>
}
else
{
    <p class="mb-0">@Model.Notes</p>
}

@if (Model.Result != null)
{
    <section class="border-top mt-4 pt-3">
        <h4 class="h6 mb-3">Result</h4>

        <dl class="row mb-3">
            <dt class="col-7">Actual distance</dt>
            <dd class="col-5 text-end">@Model.Result.ActualDistance m</dd>
            <dt class="col-7">Actual duration</dt>
            <dd class="col-5 text-end">@Model.Result.ActualDuration min</dd>
            <dt class="col-7">Completed on</dt>
            <dd class="col-5 text-end">@Model.Result.CompletedAt.ToString(DateTimeFormat)</dd>
        </dl>

        <h5 class="h6">Result notes</h5>
        @if (string.IsNullOrWhiteSpace(Model.Result.Notes))
        {
            <p class="text-muted mb-0">No result notes.</p>
        }
        else
        {
            <p class="mb-0">@Model.Result.Notes</p>
        }
    </section>
}
