@model ErrorViewModel
@{
    ViewData["Title"] = "Error 500";
}

<main>
    <section class="container hero-section">
        <div class="stack">
            <p class="eyebrow-heading error-eyebrow">Error 500 · Pool closed</p>
            <div class="error-code" aria-hidden="true">5<partial name="_ErrorBuoyPartial" /><partial name="_ErrorBuoyPartial" /></div>
            <h1 class="error-title">The pool is closed for maintenance.</h1>
            <p class="text-lead">That one’s on us, not you. Give it a moment and try again – if it keeps happening, send us the request ID below.</p>
            <div class="flex-row">
                <a class="button button--primary"
                   asp-controller="Home"
                   asp-action="Index"
                   onclick="window.location.reload(); return false;">
                    Try again
                </a>
                <a class="button" asp-controller="Home" asp-action="Index">Back to home</a>
            </div>
            @if (Model.ShowRequestId)
            {
                <div class="lane-rope-divider"></div>
                <div class="form-field">
                    <label>Request ID</label>
                    <code class="error-request-id">@Model.RequestId</code>
                </div>
            }
        </div>
