@model WorkoutInputModel

@{
    ViewData["Title"] = "Edit workout";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <h1 class="mb-4">Edit workout</h1>

        @if (Model.Status == WorkoutStatus.Completed)
        {
            <div class="alert alert-info mb-3" role="alert">
                This workout is <strong>completed</strong>. Only notes can be edited.
            </div>
        }
        else if (Model.Status == WorkoutStatus.Skipped)
        {
            <div class="alert alert-warning mb-3" role="alert">
                This workout is <strong>skipped</strong>. Only notes can be edited.
            </div>
        }

        <form asp-controller="Workout"
              asp-action="Edit"
              asp-route-trainingPlanId="@ViewData["TrainingPlanId"]"
              method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <partial name="_WorkoutInputPartial" model="Model" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a asp-controller="TrainingPlan"
                   asp-action="Details"
                   asp-route-id="@ViewData["TrainingPlanId"]"
                   class="btn btn-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
