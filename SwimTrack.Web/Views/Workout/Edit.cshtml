@model WorkoutInputModel
@{
    ViewData["Title"] = "Edit workout";

    int trainingPlanId = (int)(ViewData["TrainingPlanId"] ?? 0);
}

<main class="container page-content">
    <div class="stack stack--compact">
        <a class="text-muted" asp-controller="TrainingPlan" asp-action="Details" asp-route-id="@trainingPlanId">← Back to plan</a>
        <h1 class="page-title">Edit workout</h1>
    </div>

    <div class="layout-split layout-split--sidebar-left">
        <aside class="card">
            <p class="eyebrow-heading">Workout status</p>
            @if (Model.Status == WorkoutStatus.Completed)
            {
                <span class="badge badge--completed">Completed</span>
                <p class="text-muted">This workout is already logged as completed. Only notes can be adjusted.</p>
            }
            else if (Model.Status == WorkoutStatus.Skipped)
            {
                <span class="badge badge--skipped">Skipped</span>
                <p class="text-muted">This workout was skipped. Only notes can be adjusted, or use "Plan again" from the plan details page.</p>
            }
            else
            {
                <span class="badge badge--planned">Planned</span>
                <p class="text-muted">Adjust the scheduled date, target distance, duration, or workout focus notes.</p>
            }
        </aside>

        <form class="card"
              asp-controller="Workout"
              asp-action="Edit"
              asp-route-id="@Model.Id"
              asp-route-trainingPlanId="@trainingPlanId"
              method="post">
            <div class="field-validation-error" asp-validation-summary="ModelOnly"></div>

            <h3>Workout details</h3>

            <partial name="_WorkoutInputPartial" model="Model" />

            <div class="flex-row form-actions--spaced">
                <button class="button button--primary" type="submit">Save changes</button>
                <a class="button" asp-controller="TrainingPlan" asp-action="Details" asp-route-id="@trainingPlanId">Cancel</a>
            </div>
        </form>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
