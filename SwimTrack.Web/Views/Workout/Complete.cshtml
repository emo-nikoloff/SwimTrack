@model WorkoutResultInputModel

@{
    ViewData["Title"] = "Complete workout";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <h1 class="mb-4">Complete workout</h1>

        <form asp-controller="Workout"
              asp-action="Complete"
              asp-route-id="@ViewData["WorkoutId"]"
              asp-route-trainingPlanId="@ViewData["TrainingPlanId"]"
              method="post">
            <div class="card mb-3">
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="ActualDistance" class="form-label">Actual distance</label>
                        <input asp-for="ActualDistance" type="number" min="1" class="form-control" />
                        <span asp-validation-for="ActualDistance" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ActualDuration" class="form-label">Actual duration</label>
                        <input asp-for="ActualDuration" type="number" min="1" class="form-control" />
                        <span asp-validation-for="ActualDuration" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CompletedAt" class="form-label">Completion date</label>
                        <input asp-for="CompletedAt" type="date" class="form-control" />
                        <span asp-validation-for="CompletedAt" class="text-danger"></span>
                    </div>

                    <div>
                        <label asp-for="Notes" class="form-label">Notes</label>
                        <textarea asp-for="Notes" class="form-control"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">Complete workout</button>
                <a asp-controller="TrainingPlan"
                   asp-action="Details"
                   asp-route-id="@ViewData["TrainingPlanId"]"
                   class="btn btn-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
