@model BaseSwimmingPoolFormInputModel

<section class="card">
    <h3>Pool</h3>
    <div class="form-field">
        <label asp-for="Name">Name</label>
        <input asp-for="Name" autocomplete="off" placeholder="e.g. Diana National Pool, Sparta Complex" />
        <small>3–100 characters</small>
        <span class="field-validation-error" asp-validation-for="Name"></span>
    </div>

    <div class="form-field">
        <label asp-for="Length">Length (metres)</label>
        <input asp-for="Length" type="number" step="1" min="10" max="100" placeholder="e.g. 25 or 50" />
        <small>Between 10 and 100 metres</small>
        <span class="field-validation-error" asp-validation-for="Length"></span>
    </div>

    <div class="form-field">
        <label asp-for="Location">Location (optional)</label>
        <input asp-for="Location" autocomplete="off" placeholder="e.g. Sofia, Dianabad district" />
        <small>Up to 200 characters</small>
        <span class="field-validation-error" asp-validation-for="Location"></span>
    </div>
</section>
