@model CreateSwimmingPoolFormInputModel
@{
    ViewData["Title"] = "Create swimming pool";
}

<main class="container page-content">
    <div>
        <p class="eyebrow-heading">Add a facility</p>
        <h1 class="page-title">Create swimming pool</h1>
    </div>

    <form asp-controller="SwimmingPool" asp-action="Create" method="post">
        <div class="stack form-page-stack">
            <div class="field-validation-error" asp-validation-summary="ModelOnly"></div>

            <partial name="_SwimmingPoolInputPartial" model="Model" />

            <div class="flex-row">
                <button class="button button--primary" type="submit">Save</button>
                <a class="button" asp-controller="SwimmingPool" asp-action="All">Cancel</a>
            </div>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
