@model SwimmingPoolDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
}

<main class="container page-content">
    <a class="text-muted" asp-controller="SwimmingPool" asp-action="All">← Back to pools</a>

    <section class="d-flex flex-wrap align-items-start justify-content-between gap-32">
        <div class="stack plan-details-intro">
            <p class="eyebrow-heading">Swimming pool</p>
            <h1 class="plan-title">@Model.Name</h1>
            @if (!string.IsNullOrWhiteSpace(Model.Location))
            {
                <p class="text-muted">@Model.Location</p>
            }
            else
            {
                <p class="text-muted">No location specified</p>
            }
            <div class="flex-row">
                <a class="button button--dark" asp-controller="SwimmingPool" asp-action="Edit" asp-route-id="@Model.Id">Edit pool</a>
            </div>
        </div>

        <div class="card plan-progress-card">
            <div class="stack plan-progress-details">
                <span class="stat-number">@Model.Length m</span>
                <small>pool length</small>
            </div>
        </div>
    </section>

    <section class="card card--horizontal">
        <div>
            <h3>Remove this pool</h3>
            <small>Associated workouts and plans will be unlinked.</small>
        </div>
        <button class="button button--danger" type="button" popovertarget="rm">Remove</button>
        <div class="popover-dialog" id="rm" popover="">
            <h3>Remove “@Model.Name”?</h3>
            <p class="text-muted remove-plan-warning">This cannot be undone. Associated workouts and plans will have their pool reference removed.</p>
            <div class="flex-row">
                <form class="inline-form" asp-controller="SwimmingPool" asp-action="Remove" asp-route-id="@Model.Id" method="post">
                    <button class="button button--danger" type="submit">Yes, remove</button>
                </form>
                <button class="button" type="button" popovertarget="rm" popovertargetaction="hide">Keep it</button>
            </div>
        </div>
    </section>
</main>
