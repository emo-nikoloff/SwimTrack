@model TrainingPlanInputModel

@{
    ViewData["Title"] = "Create training plan";
    List<WorkoutInputModel> trainingPlanWorkouts = Model.Workouts.ToList();
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <h1 class="mb-4">Create training plan</h1>

        <form asp-controller="TrainingPlan" asp-action="Create" method="post">
            <partial name="_TrainingPlanInputPartial" model="Model" />

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0">Workouts</h2>
                <button type="submit"
                        formaction="@Url.Action("Create", new
                        {
                            workoutAction = "add"
                        })"
                        class="btn btn-outline-primary">
                    Add workout
                </button>
            </div>

            @for (int i = 0; i < trainingPlanWorkouts.Count; i++)
            {
                ViewDataDictionary workoutViewData = new ViewDataDictionary(ViewData);
                workoutViewData.TemplateInfo.HtmlFieldPrefix = $"Workouts[{i}]";

                <div class="d-flex justify-content-end">
                    <button type="submit"
                            formaction="@Url.Action("Create", new
                            {
                                workoutAction = "remove",
                                workoutIndex = i
                            })"
                            class="btn btn-sm btn-outline-danger">
                        Remove
                    </button>
                </div>
                
                <partial name="_WorkoutInputPartial" model="trainingPlanWorkouts[i]" view-data="workoutViewData" />
            }

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-controller="TrainingPlan" asp-action="All" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
