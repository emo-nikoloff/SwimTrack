@model TrainingPlanInputModel
@{
    ViewData["Title"] = "Create training plan";

    List<WorkoutInputModel> trainingPlanWorkouts = Model.Workouts;
}

<main class="container page-content">
    <div>
        <p class="eyebrow-heading">Start your journey</p>
        <h1 class="page-title">Create training plan</h1>
    </div>

    <form asp-controller="TrainingPlan" asp-action="Create" method="post">
        <div class="stack form-page-stack">
            <partial name="_TrainingPlanInputPartial" model="Model" />

            <div class="d-flex flex-wrap align-items-center justify-content-between gap-12">
                <h2>Workouts</h2>
                <button class="button" type="submit"
                        asp-controller="TrainingPlan"
                        asp-action="Create"
                        asp-route-workoutAction="add"
                        formnovalidate
                       >
                    + Add workout
                </button>
            </div>

            @if (!trainingPlanWorkouts.Any())
            {
                <div class="card card--center">
                    <p class="text-muted">No workouts added yet. Click "+ Add workout" to plan sessions.</p>
                </div>
            }
            else
            {
                @for (int i = 0; i < trainingPlanWorkouts.Count; i++)
                {
                    WorkoutInputModel currentWorkout = trainingPlanWorkouts[i];
                    ViewDataDictionary workoutViewData = new ViewDataDictionary(ViewData);
                    workoutViewData.TemplateInfo.HtmlFieldPrefix = $"Workouts[{i}]";

                    <div class="card stack workout-input-card">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-12">
                            <div class="flex-row workout-input-header">
                                <span class="index-chip">@(i + 1)</span>
                                <b>Workout @(i + 1)</b>
                            </div>
                            <button class="button button--small button--danger" type="submit"
                                    asp-controller="TrainingPlan"
                                    asp-action="Create"
                                    asp-route-workoutAction="remove"
                                    asp-route-workoutIndex="@i"
                                    formnovalidate
                                   >
                                Remove
                            </button>
                        </div>

                        <partial name="_WorkoutInputPartial" model="currentWorkout" view-data="workoutViewData" />
                    </div>
                }
            }

            <div class="field-validation-error" asp-validation-summary="ModelOnly"></div>

            <div class="flex-row">
                <button class="button button--primary" type="submit">Save</button>
                <a class="button" asp-controller="TrainingPlan" asp-action="All">Cancel</a>
            </div>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
