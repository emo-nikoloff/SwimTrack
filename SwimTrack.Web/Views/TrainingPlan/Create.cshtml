@model TrainingPlanInputModel
@{
    ViewData["Title"] = "Create training plan";
    List<WorkoutInputModel> trainingPlanWorkouts = Model.Workouts;
}

<main class="wrap pg">
    <div>
        <p class="eb">Start your journey</p>
        <h1 style="font-size:56px">Create training plan</h1>
    </div>

    <form asp-controller="TrainingPlan" asp-action="Create" method="post">
        <div class="stack" style="gap:32px;max-width:880px">
            <partial name="_TrainingPlanInputPartial" model="Model" />

            <div class="row sp">
                <h2>Workouts</h2>
                <button type="submit"
                        asp-controller="TrainingPlan"
                        asp-action="Create"
                        asp-route-workoutAction="add"
                        formnovalidate
                        class="btn">
                    + Add workout
                </button>
            </div>

            @if (!trainingPlanWorkouts.Any())
            {
                <div class="card ctr">
                    <p class="mut">No workouts added yet. Click "+ Add workout" to plan sessions.</p>
                </div>
            }
            else
            {
                @for (int i = 0; i < trainingPlanWorkouts.Count; i++)
                {
                    ViewDataDictionary workoutViewData = new ViewDataDictionary(ViewData);
                    workoutViewData.TemplateInfo.HtmlFieldPrefix = $"Workouts[{i}]";

                    <div class="card stack" style="gap:16px">
                        <div class="row sp">
                            <div class="row" style="gap:10px">
                                <span class="chip">@(i + 1)</span>
                                <b>Workout @(i + 1)</b>
                            </div>
                            <button type="submit"
                                    asp-controller="TrainingPlan"
                                    asp-action="Create"
                                    asp-route-workoutAction="remove"
                                    asp-route-workoutIndex="@i"
                                    formnovalidate
                                    class="btn sm dg">
                                Remove
                            </button>
                        </div>

                        <partial name="_WorkoutInputPartial" model="trainingPlanWorkouts[i]" view-data="workoutViewData" />
                    </div>
                }
            }

            <div asp-validation-summary="ModelOnly" class="er"></div>

            <div class="row">
                <button class="btn go" type="submit">Save</button>
                <a class="btn" asp-controller="TrainingPlan" asp-action="All">Cancel</a>
            </div>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
