@model CreateTrainingPlanFormInputModel
@{
    ViewData["Title"] = "Create training plan";
}

<main class="container page-content">
    <div>
        <p class="eyebrow-heading">Start your journey</p>
        <h1 class="page-title">Create training plan</h1>
    </div>

    <form asp-controller="TrainingPlan" asp-action="Create" method="post">
        <div class="stack form-page-stack">
            <div class="field-validation-error" asp-validation-summary="ModelOnly"></div>

            <partial name="_TrainingPlanInputPartial" model="Model" />

            <div class="d-flex flex-wrap align-items-center justify-content-between gap-12">
                <h2>Workouts</h2>
                <button class="button" type="button" id="add-workout-btn">
                    + Add workout
                </button>
            </div>

            <div id="no-workouts-message" class="card card--center" @(Model.Workouts.Count == 0 ? null : "hidden")>
                <p class="text-muted">No workouts added yet. Click "+ Add workout" to plan sessions.</p>
            </div>

            <div id="workouts-container" class="stack" data-new-workouts-prefix="Workouts">
                @for (int i = 0; i < Model.Workouts.Count; i++)
                {
                    <partial name="_WorkoutCardPartial" for="Workouts[i]" />
                }
            </div>

            <div class="flex-row">
                <button class="button button--primary" type="submit">Save</button>
                <a class="button" asp-controller="TrainingPlan" asp-action="All">Cancel</a>
            </div>
        </div>
    </form>

    <template id="workout-card-template">
        <partial name="_WorkoutCardPartial" model="new WorkoutFormInputModel()" />
    </template>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/training-plan-form.js" asp-append-version="true"></script>
}
