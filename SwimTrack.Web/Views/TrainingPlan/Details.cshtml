@model TrainingPlanViewModel
@{
    ViewData["Title"] = Model.Name;

    int totalWorkoutsCount = Model.Workouts.Count();
    int doneWorkoutsCount = Model.Workouts.Count(w => w.Status == WorkoutStatus.Completed);
    int skippedWorkoutsCount = Model.Workouts.Count(w => w.Status == WorkoutStatus.Skipped);
    int plannedWorkoutsCount = Model.Workouts.Count(w => w.Status == WorkoutStatus.Planned);
    int doneWorkoutsPercent = totalWorkoutsCount > 0 ? (int)Math.Round((double)doneWorkoutsCount / totalWorkoutsCount * 100) : 0;

    int totalSwumDistance = Model.Workouts
        .Where(w => w.Status == WorkoutStatus.Completed)
        .Sum(w => w.Result?.ActualDistance ?? w.PlannedDistance);

    List<WorkoutViewModel>? sortedWorkouts = Model.Workouts.OrderBy(w => w.Date).ToList();
    DateTime planStartMonday = Model.StartDate.Date.AddDays(-((7 + (Model.StartDate.DayOfWeek - DayOfWeek.Monday)) % 7));

    List<IGrouping<DateTime, WorkoutViewModel>>? weekGroups = sortedWorkouts
        .GroupBy(w => w.Date.Date.AddDays(-((7 + (w.Date.DayOfWeek - DayOfWeek.Monday)) % 7)))
        .OrderBy(g => g.Key)
        .ToList();
}

<main class="container page-content">
    <a class="text-muted" asp-controller="TrainingPlan" asp-action="All">← Back to plans</a>

    <section class="d-flex flex-wrap align-items-start justify-content-between gap-32">
        <div class="stack plan-details-intro">
            <p class="eyebrow-heading">Training plan</p>
            <h1 class="plan-title">@Model.Name</h1>
            <p class="text-muted">@Model.StartDate.ToString(DateTimeFormat) – @Model.EndDate.ToString(DateTimeFormat) · @totalWorkoutsCount workouts</p>
            @if (!string.IsNullOrWhiteSpace(Model.Goal))
            {
                <blockquote class="plan-goal-card">“@Model.Goal”</blockquote>
            }
            <div class="flex-row">
                <a class="button button--dark" asp-controller="TrainingPlan" asp-action="Edit" asp-route-id="@Model.Id">Edit plan & workouts</a>
            </div>
        </div>

        <div class="card plan-progress-card">
            <div class="progress-ring" style="--p:@doneWorkoutsPercent"><b>@doneWorkoutsCount/@totalWorkoutsCount</b></div>
            <div class="stack plan-progress-details">
                <span class="stat-number">@totalSwumDistance m</span>
                <small>swum so far</small>
                <small>@skippedWorkoutsCount skipped · @plannedWorkoutsCount to go</small>
            </div>
        </div>
    </section>

    <div class="workout-strip" role="img" aria-label="@doneWorkoutsCount completed, @skippedWorkoutsCount skipped, @plannedWorkoutsCount planned">
        @foreach (WorkoutViewModel workout in sortedWorkouts)
        {
            if (workout.Status == WorkoutStatus.Completed)
            {
                <i class="workout-strip-item workout-strip-item--completed"></i>
            }
            else if (workout.Status == WorkoutStatus.Skipped)
            {
                <i class="workout-strip-item workout-strip-item--skipped"></i>
            }
            else
            {
                <i class="workout-strip-item"></i>
            }
        }
    </div>

    @if (!sortedWorkouts.Any())
    {
        <div class="card card--center">
            <p class="text-muted">No workouts planned yet.</p>
            <a class="button button--small button--primary" asp-action="Edit" asp-route-id="@Model.Id">Add workouts to plan</a>
        </div>
    }
    else
    {
        @foreach (IGrouping<DateTime, WorkoutViewModel> week in weekGroups)
        {
            int weekNumber = Math.Max(1, ((int)(week.Key - planStartMonday).TotalDays / 7) + 1);
            DateTime weekEnd = week.Key.AddDays(6);

            <section class="stack">
                <div class="week-divider eyebrow-heading">Week @weekNumber · @week.Key.ToString(DateTimeFormat) – @weekEnd.ToString(DateTimeFormat)</div>
                <div class="grid-3-columns">
                    @foreach (WorkoutViewModel workout in week)
                    {
                        if (workout.Status == WorkoutStatus.Skipped)
                        {
                            <article class="workout-card workout-card--skipped">
                                <header>
                                    <div class="workout-card-date">
                                        <b class="workout-date-heading">@workout.Date.ToString(DateTimeFormat)</b>
                                    </div>
                                    <span class="badge badge--skipped">Skipped</span>
                                </header>
                                <div class="key-value-row">
                                    <span>Planned</span>
                                    <b>@workout.PlannedDistance m · @workout.PlannedDuration min</b>
                                </div>
                                <p class="workout-card-note">@(string.IsNullOrWhiteSpace(workout.Notes) ? "No notes." : workout.Notes)</p>
                                <footer>
                                    <a class="button button--small" asp-controller="Workout" asp-action="Edit" asp-route-id="@workout.Id" asp-route-trainingPlanId="@Model.Id">Edit notes</a>
                                    <form class="inline-form" asp-controller="Workout" asp-action="PlanAgain" asp-route-id="@workout.Id" asp-route-trainingPlanId="@Model.Id" method="post">
                                        <button class="button button--small button--primary" type="submit">Plan again</button>
                                    </form>
                                </footer>
                            </article>
                        }
                        else if (workout.Status == WorkoutStatus.Completed)
                        {
                            int actualDistance = workout.Result?.ActualDistance ?? workout.PlannedDistance;
                            int actualDuration = workout.Result?.ActualDuration ?? workout.PlannedDuration;
                            string noteText = !string.IsNullOrWhiteSpace(workout.Result?.Notes) ? workout.Result.Notes : (!string.IsNullOrWhiteSpace(workout.Notes) ? workout.Notes : "No notes.");

                            int plannedDistancePercent = Math.Min(100, Math.Max(15, (int)Math.Round((double)workout.PlannedDistance / 2000.0 * 100)));
                            int actualDistancePercent = Math.Min(100, Math.Max(15, (int)Math.Round((double)actualDistance / 2000.0 * 100)));

                            <article class="workout-card">
                                <header>
                                    <div>
                                        <b class="workout-date-heading">@workout.Date.ToString(DateTimeFormat)</b>
                                        @if (workout.Result != null && workout.Result.CompletedAt.Date != workout.Date.Date)
                                        {
                                            <small class="text-muted workout-completed-date">Swum @workout.Result.CompletedAt.ToString(DateTimeFormat)</small>
                                        }
                                    </div>
                                    <span class="badge badge--completed">Completed</span>
                                </header>
                                <div class="stack stack--tight">
                                    <div class="key-value-row">
                                        <span>Planned</span>
                                        <b>@workout.PlannedDistance m · @workout.PlannedDuration min</b>
                                    </div>
                                    <div class="progress-bar progress-bar--planned"><i style="--w:@plannedDistancePercent"></i></div>
                                    <div class="key-value-row">
                                        <span>Actual</span>
                                        <b>@actualDistance m · @actualDuration min</b>
                                    </div>
                                    <div class="progress-bar"><i style="--w:@actualDistancePercent"></i></div>
                                </div>
                                <p class="workout-card-note">@noteText</p>
                                <footer>
                                    <a class="button button--small" asp-controller="Workout" asp-action="Edit" asp-route-id="@workout.Id" asp-route-trainingPlanId="@Model.Id">Edit notes</a>
                                </footer>
                            </article>
                        }
                        else
                        {
                            bool isToday = workout.Date.Date == DateTime.Today;
                            int plannedDistancePercent = Math.Min(100, Math.Max(15, (int)Math.Round((double)workout.PlannedDistance / 2000.0 * 100)));

                            <article class="workout-card @(isToday ? "workout-card--today" : "")">
                                <header>
                                    <div class="workout-card-date">
                                        <b class="workout-date-heading">@workout.Date.ToString(DateTimeFormat)</b>
                                        @if (isToday)
                                        {
                                            <span>Today</span>
                                        }
                                    </div>
                                    <span class="badge badge--planned">Planned</span>
                                </header>
                                <div class="stack stack--tight">
                                    <div class="key-value-row">
                                        <span>Planned</span>
                                        <b>@workout.PlannedDistance m · @workout.PlannedDuration min</b>
                                    </div>
                                    <div class="progress-bar progress-bar--planned"><i style="--w:@plannedDistancePercent"></i></div>
                                </div>
                                <p class="workout-card-note">@(string.IsNullOrWhiteSpace(workout.Notes) ? "Steady pace." : workout.Notes)</p>
                                <footer>
                                    @if (workout.Date.Date <= DateTime.Today)
                                    {
                                        <a class="button button--small button--primary" asp-controller="Workout" asp-action="Complete" asp-route-id="@workout.Id" asp-route-trainingPlanId="@Model.Id">Complete</a>
                                        <form class="inline-form" asp-controller="Workout" asp-action="Skip" asp-route-id="@workout.Id" asp-route-trainingPlanId="@Model.Id" method="post">
                                            <button class="button button--small button--warning" type="submit">Skip</button>
                                        </form>
                                    }
                                    <a class="button button--small" asp-controller="Workout" asp-action="Edit" asp-route-id="@workout.Id" asp-route-trainingPlanId="@Model.Id">Edit</a>
                                </footer>
                            </article>
                        }
                    }
                </div>
            </section>
        }
    }

    <section class="card card--horizontal">
        <div>
            <h3>Remove this plan</h3>
            <small>All @totalWorkoutsCount workouts and results are deleted with it.</small>
        </div>
        <button class="button button--danger" type="button" popovertarget="rm">Remove</button>
        <div class="popover-dialog" id="rm" popover="">
            <h3>Remove “@Model.Name”?</h3>
            <p class="text-muted remove-plan-warning">This cannot be undone.</p>
            <div class="flex-row">
                <form class="inline-form" asp-controller="TrainingPlan" asp-action="Remove" asp-route-id="@Model.Id" method="post">
                    <button class="button button--danger" type="submit">Yes, remove</button>
                </form>
                <button class="button" type="button" popovertarget="rm" popovertargetaction="hide">Keep it</button>
            </div>
        </div>
    </section>
</main>
