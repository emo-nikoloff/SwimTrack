@model TrainingPlanViewModel
@{
    ViewData["Title"] = Model.Name;

    int totalWorkoutsCount = Model.Workouts.Count();
    int doneWorkoutsCount = Model.Workouts.Count(w => w.Status == WorkoutStatus.Completed);
    int skippedWorkoutsCount = Model.Workouts.Count(w => w.Status == WorkoutStatus.Skipped);
    int plannedWorkoutsCount = Model.Workouts.Count(w => w.Status == WorkoutStatus.Planned);
    int doneWorkoutsPercent = totalWorkoutsCount > 0 ? (int)Math.Round((double)doneWorkoutsCount / totalWorkoutsCount * 100) : 0;

    int totalSwumDistance = Model.Workouts
        .Where(w => w.Status == WorkoutStatus.Completed)
        .Sum(w => w.Result?.ActualDistance ?? w.PlannedDistance);

    List<WorkoutViewModel>? sortedWorkouts = Model.Workouts.OrderBy(w => w.Date).ToList();
    DateTime planStartMonday = Model.StartDate.Date.AddDays(-((7 + (Model.StartDate.DayOfWeek - DayOfWeek.Monday)) % 7));

    List<IGrouping<DateTime, WorkoutViewModel>>? weekGroups = sortedWorkouts
        .GroupBy(w => w.Date.Date.AddDays(-((7 + (w.Date.DayOfWeek - DayOfWeek.Monday)) % 7)))
        .OrderBy(g => g.Key)
        .ToList();
}

<main class="wrap pg">
    <a class="mut" asp-controller="TrainingPlan" asp-action="All">← Back to plans</a>

    <section class="row sp" style="gap:32px;align-items:flex-start">
        <div class="stack" style="max-width:640px">
            <p class="eb">Training plan</p>
            <h1 style="font-size:64px">@Model.Name</h1>
            <p class="mut">@Model.StartDate.ToString(DateTimeFormat) – @Model.EndDate.ToString(DateTimeFormat) · @totalWorkoutsCount workouts</p>
            @if (!string.IsNullOrWhiteSpace(Model.Goal))
            {
                <blockquote class="goal">“@Model.Goal”</blockquote>
            }
            <div class="row">
                <a class="btn dk" asp-controller="TrainingPlan" asp-action="Edit" asp-route-id="@Model.Id">Edit plan & workouts</a>
            </div>
        </div>

        <div class="card" style="grid-auto-flow:column;gap:32px;align-items:center">
            <div class="ring" style="--p:@doneWorkoutsPercent"><b>@doneWorkoutsCount/@totalWorkoutsCount</b></div>
            <div class="stack" style="gap:6px">
                <span class="n">@totalSwumDistance m</span>
                <small>swum so far</small>
                <small>@skippedWorkoutsCount skipped · @plannedWorkoutsCount to go</small>
            </div>
        </div>
    </section>

    <div class="strip" role="img" aria-label="@doneWorkoutsCount completed, @skippedWorkoutsCount skipped, @plannedWorkoutsCount planned">
        @foreach (WorkoutViewModel workout in sortedWorkouts)
        {
            if (workout.Status == WorkoutStatus.Completed)
            {
                <i class="d"></i>
            }
            else if (workout.Status == WorkoutStatus.Skipped)
            {
                <i class="s"></i>
            }
            else
            {
                <i></i>
            }
        }
    </div>

    @if (!sortedWorkouts.Any())
    {
        <div class="card ctr">
            <p class="mut">No workouts planned yet.</p>
            <a class="btn sm go" asp-action="Edit" asp-route-id="@Model.Id">Add workouts to plan</a>
        </div>
    }
    else
    {
        @foreach (IGrouping<DateTime, WorkoutViewModel> week in weekGroups)
        {
            int weekNumber = Math.Max(1, ((int)(week.Key - planStartMonday).TotalDays / 7) + 1);
            DateTime weekEnd = week.Key.AddDays(6);

            <section class="stack">
                <div class="wl eb">Week @weekNumber · @week.Key.ToString(DateTimeFormat) – @weekEnd.ToString(DateTimeFormat)</div>
                <div class="g3">
                    @foreach (WorkoutViewModel workout in week)
                    {
                        if (workout.Status == WorkoutStatus.Skipped)
                        {
                            <article class="wk sk">
                                <div class="row sp">
                                    <div class="dt">
                                        <b style="font-size:24px">@workout.Date.ToString(DateTimeFormat)</b>
                                    </div>
                                    <span class="bd sk">Skipped</span>
                                </div>
                                <div class="kv">
                                    <span>Planned</span>
                                    <b>@workout.PlannedDistance m · @workout.PlannedDuration min</b>
                                </div>
                                <p class="note">@(string.IsNullOrWhiteSpace(workout.Notes) ? "No notes." : workout.Notes)</p>
                                <footer>
                                    <a class="btn sm" asp-controller="Workout" asp-action="Edit" asp-route-id="@workout.Id" asp-route-trainingPlanId="@Model.Id">Edit notes</a>
                                    <form asp-controller="Workout" asp-action="PlanAgain" asp-route-id="@workout.Id" asp-route-trainingPlanId="@Model.Id" method="post" style="display:inline;margin:0;">
                                        <button class="btn sm go" type="submit">Plan again</button>
                                    </form>
                                </footer>
                            </article>
                        }
                        else if (workout.Status == WorkoutStatus.Completed)
                        {
                            int actualDistance = workout.Result?.ActualDistance ?? workout.PlannedDistance;
                            int actualDuration = workout.Result?.ActualDuration ?? workout.PlannedDuration;
                            string noteText = !string.IsNullOrWhiteSpace(workout.Result?.Notes) ? workout.Result.Notes : (!string.IsNullOrWhiteSpace(workout.Notes) ? workout.Notes : "No notes.");

                            int plannedDistancePercent = Math.Min(100, Math.Max(15, (int)Math.Round((double)workout.PlannedDistance / 2000.0 * 100)));
                            int actualDistancePercent = Math.Min(100, Math.Max(15, (int)Math.Round((double)actualDistance / 2000.0 * 100)));

                            <article class="wk">
                                <div class="row sp" style="align-items:flex-start">
                                    <div>
                                        <b style="font-size:24px">@workout.Date.ToString(DateTimeFormat)</b>
                                        @if (workout.Result != null && workout.Result.CompletedAt.Date != workout.Date.Date)
                                        {
                                            <small class="mut" style="display:block;margin-top:2px">Swum @workout.Result.CompletedAt.ToString(DateTimeFormat)</small>
                                        }
                                    </div>
                                    <span class="bd dn">Completed</span>
                                </div>
                                <div class="stack" style="gap:8px">
                                    <div class="kv">
                                        <span>Planned</span>
                                        <b>@workout.PlannedDistance m · @workout.PlannedDuration min</b>
                                    </div>
                                    <div class="bar pl"><i style="--w:@plannedDistancePercent"></i></div>
                                    <div class="kv">
                                        <span>Actual</span>
                                        <b>@actualDistance m · @actualDuration min</b>
                                    </div>
                                    <div class="bar"><i style="--w:@actualDistancePercent"></i></div>
                                </div>
                                <p class="note">@noteText</p>
                                <footer>
                                    <a class="btn sm" asp-controller="Workout" asp-action="Edit" asp-route-id="@workout.Id" asp-route-trainingPlanId="@Model.Id">Edit notes</a>
                                </footer>
                            </article>
                        }
                        else
                        {
                            bool isToday = workout.Date.Date == DateTime.Today;
                            int plannedDistancePercent = Math.Min(100, Math.Max(15, (int)Math.Round((double)workout.PlannedDistance / 2000.0 * 100)));

                            <article class="wk @(isToday ? "tdy" : "")">
                                <div class="row sp">
                                    <div class="dt">
                                        <b style="font-size:24px">@workout.Date.ToString(DateTimeFormat)</b>
                                        @if (isToday)
                                        {
                                            <span>Today</span>
                                        }
                                    </div>
                                    <span class="bd">Planned</span>
                                </div>
                                <div class="stack" style="gap:8px">
                                    <div class="kv">
                                        <span>Planned</span>
                                        <b>@workout.PlannedDistance m · @workout.PlannedDuration min</b>
                                    </div>
                                    <div class="bar pl"><i style="--w:@plannedDistancePercent"></i></div>
                                </div>
                                <p class="note">@(string.IsNullOrWhiteSpace(workout.Notes) ? "Steady pace." : workout.Notes)</p>
                                <footer>
                                    @if (workout.Date.Date <= DateTime.Today)
                                    {
                                        <a class="btn sm go" asp-controller="Workout" asp-action="Complete" asp-route-id="@workout.Id" asp-route-trainingPlanId="@Model.Id">Complete</a>
                                        <form asp-controller="Workout" asp-action="Skip" asp-route-id="@workout.Id" asp-route-trainingPlanId="@Model.Id" method="post" style="display:inline;margin:0;">
                                            <button class="btn sm sk" type="submit">Skip</button>
                                        </form>
                                    }
                                    <a class="btn sm" asp-controller="Workout" asp-action="Edit" asp-route-id="@workout.Id" asp-route-trainingPlanId="@Model.Id">Edit</a>
                                </footer>
                            </article>
                        }
                    }
                </div>
            </section>
        }
    }

    <section class="card row sp" style="display:flex">
        <div>
            <h3>Remove this plan</h3>
            <small>All @totalWorkoutsCount workouts and results are deleted with it.</small>
        </div>
        <button class="btn dg" type="button" popovertarget="rm">Remove</button>
        <div class="pop" id="rm" popover="">
            <h3>Remove “@Model.Name”?</h3>
            <p class="mut" style="margin:10px 0 20px">This cannot be undone.</p>
            <div class="row">
                <form asp-controller="TrainingPlan" asp-action="Remove" asp-route-id="@Model.Id" method="post" style="display:inline;margin:0;">
                    <button class="btn dg" type="submit">Yes, remove</button>
                </form>
                <button class="btn" type="button" popovertarget="rm" popovertargetaction="hide">Keep it</button>
            </div>
        </div>
    </section>
</main>
