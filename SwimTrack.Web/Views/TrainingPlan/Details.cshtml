@model TrainingPlanViewModel

@{
    ViewData["Title"] = "Training plan details";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">@Model.Name</h1>
        <p class="text-muted mb-0">
            @Model.StartDate.ToString(DateTimeFormat)
            &ndash;
            @Model.EndDate.ToString(DateTimeFormat)
        </p>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="TrainingPlan" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-controller="TrainingPlan" asp-action="All" class="btn btn-outline-secondary">Back to plans</a>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h2 class="h5">Goal</h2>
        @if (string.IsNullOrWhiteSpace(Model.Goal))
        {
            <p class="text-muted mb-0">No goal specified.</p>
        }
        else
        {
            <p class="mb-0">@Model.Goal</p>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <h2 class="h5 mb-3">Workouts (@Model.Workouts.Count())</h2>

        @if (!Model.Workouts.Any())
        {
            <p class="text-muted mb-0">No workouts have been added to this plan.</p>
        }
        else
        {
            <div class="row g-4">
                @foreach (WorkoutViewModel workout in Model.Workouts.OrderBy(w => w.Date))
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <article class="card h-100 shadow-sm">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
                                    <h3 class="h4 mb-0">@workout.Date.ToString(DateTimeFormat)</h3>
                                    <span class="badge text-bg-primary">@workout.Status</span>
                                </div>

                                <dl class="row mb-4">
                                    <dt class="col-7">Planned distance</dt>
                                    <dd class="col-5 text-end">@workout.PlannedDistance m</dd>
                                    <dt class="col-7">Planned duration</dt>
                                    <dd class="col-5 text-end">@workout.PlannedDuration min</dd>
                                </dl>

                                <h4 class="h6">Notes</h4>
                                @if (string.IsNullOrWhiteSpace(workout.Notes))
                                {
                                    <p class="text-muted mb-0">No notes.</p>
                                }
                                else
                                {
                                    <p class="mb-0">@workout.Notes</p>
                                }
                            </div>
                            <div class="card-footer bg-transparent border-top">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-controller="Workout"
                                       asp-action="Edit"
                                       asp-route-id="@workout.Id"
                                       asp-route-trainingPlanId="@Model.Id"
                                       class="btn btn-outline-primary">
                                        Edit
                                    </a>
                                    @if (workout.Status == WorkoutStatus.Planned)
                                    {
                                        <a asp-controller="Workout"
                                           asp-action="Complete"
                                           asp-route-id="@workout.Id"
                                           asp-route-trainingPlanId="@Model.Id"
                                           class="btn btn-success">
                                            Complete
                                        </a>
                                        <form asp-controller="Workout"
                                              asp-action="Skip"
                                              asp-route-id="@workout.Id"
                                              asp-route-trainingPlanId="@Model.Id"
                                              method="post">
                                            <button type="submit" class="btn btn-outline-warning">Skip</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</div>

<div class="d-flex justify-content-end mt-4">
    <form asp-controller="TrainingPlan"
          asp-action="Remove"
          asp-route-id="@Model.Id"
          method="post"
          onsubmit="return confirm('Are you sure you want to remove this training plan?');">
        <button type="submit" class="btn btn-danger">Remove</button>
    </form>
</div>
