@model BaseTrainingPlanFormInputModel

<section class="card">
    <h3>Plan</h3>
    <div class="form-field">
        <label asp-for="Name">Name</label>
        <input asp-for="Name" autocomplete="off" placeholder="e.g. Technique Block, Autumn Base Build" />
        <small>3–100 characters</small>
        <span class="field-validation-error" asp-validation-for="Name"></span>
    </div>

    <div class="form-field">
        <label asp-for="TrainingGoalId">Training goal (optional)</label>
        <select asp-for="TrainingGoalId">
            <option value="">No goal selected</option>
            @foreach (AllTrainingGoalsViewModel goal in Model.AvailableGoals)
            {
                <option value="@goal.Id">@goal.Title (@goal.StartDate.ToString(DateTimeFormat) – @goal.EndDate.ToString(DateTimeFormat))</option>
            }
        </select>
        <span class="field-validation-error" asp-validation-for="TrainingGoalId"></span>
    </div>

    <div class="grid-2-columns">
        <div class="form-field">
            <label asp-for="StartDate">Start date</label>
            <input asp-for="StartDate" type="date" />
            <span class="field-validation-error" asp-validation-for="StartDate"></span>
        </div>
        <div class="form-field">
            <label asp-for="EndDate">End date</label>
            <input asp-for="EndDate" type="date" />
            <span class="field-validation-error" asp-validation-for="EndDate"></span>
        </div>
    </div>
</section>
