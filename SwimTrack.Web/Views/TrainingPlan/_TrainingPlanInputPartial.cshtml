@model TrainingPlanInputModel

<section class="card">
    <h3>Plan</h3>
    <div class="form-field">
        <label asp-for="Name">Name</label>
        <input asp-for="Name" autocomplete="off" placeholder="e.g. Technique Block, Autumn Base Build" />
        <small>3–100 characters</small>
        <span asp-validation-for="Name" class="field-validation-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="Goal">Goal (optional)</label>
        <textarea asp-for="Goal" rows="3" placeholder="What are you aiming to achieve in this block?"></textarea>
        <small>Up to 250 characters</small>
        <span asp-validation-for="Goal" class="field-validation-error"></span>
    </div>

    <div class="grid-2-columns">
        <div class="form-field">
            <label asp-for="StartDate">Start date</label>
            <input asp-for="StartDate" type="date" />
            <span asp-validation-for="StartDate" class="field-validation-error"></span>
        </div>
        <div class="form-field">
            <label asp-for="EndDate">End date</label>
            <input asp-for="EndDate" type="date" />
            <span asp-validation-for="EndDate" class="field-validation-error"></span>
        </div>
    </div>
</section>
