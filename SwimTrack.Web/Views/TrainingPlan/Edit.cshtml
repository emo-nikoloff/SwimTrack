@model TrainingPlanInputModel
@{
    ViewData["Title"] = "Edit training plan";
    List<WorkoutInputModel> trainingPlanWorkouts = Model.Workouts;
    object? planId = ViewContext.RouteData.Values["id"];
}

<main class="wrap pg">
    <div>
        <p class="eb">Adjust your journey</p>
        <h1 style="font-size:56px">Edit training plan</h1>
    </div>

    <form asp-controller="TrainingPlan"
          asp-action="Edit"
          asp-route-id="@planId"
          method="post">
        <div class="stack" style="gap:32px;max-width:880px">
            <partial name="_TrainingPlanInputPartial" model="Model" />

            <div class="row sp">
                <h2>Workouts</h2>
                <button type="submit"
                        asp-controller="TrainingPlan"
                        asp-action="Edit"
                        asp-route-id="@planId"
                        asp-route-workoutAction="add"
                        formnovalidate
                        class="btn">
                    + Add workout
                </button>
            </div>

            @if (!trainingPlanWorkouts.Any())
            {
                <div class="card ctr">
                    <p class="mut">No workouts in this plan. Click "+ Add workout" to schedule sessions.</p>
                </div>
            }
            else
            {
                @for (int i = 0; i < trainingPlanWorkouts.Count; i++)
                {
                    WorkoutInputModel currentWorkout = trainingPlanWorkouts[i];
                    ViewDataDictionary workoutViewData = new ViewDataDictionary(ViewData);
                    workoutViewData.TemplateInfo.HtmlFieldPrefix = $"Workouts[{i}]";

                    <div class="card stack" style="gap:16px">
                        <div class="row sp">
                            <div class="row" style="gap:10px">
                                <span class="chip">@(i + 1)</span>
                                @if (currentWorkout.Id.HasValue)
                                {
                                    <b>Workout @(i + 1)</b>
                                }
                                else
                                {
                                    <b>New workout</b>
                                }
                            </div>
                            <button type="submit"
                                    asp-controller="TrainingPlan"
                                    asp-action="Edit"
                                    asp-route-id="@planId"
                                    asp-route-workoutAction="remove"
                                    asp-route-workoutIndex="@i"
                                    formnovalidate
                                    class="btn sm dg">
                                Remove
                            </button>
                        </div>

                        @if (currentWorkout.Id.HasValue)
                        {
                            WorkoutViewModel workoutViewModel = new()
                            {
                                Id = currentWorkout.Id.Value,
                                Date = currentWorkout.Date,
                                PlannedDistance = currentWorkout.PlannedDistance,
                                PlannedDuration = currentWorkout.PlannedDuration,
                                Notes = currentWorkout.Notes,
                                Status = currentWorkout.Status,
                            };

                            <partial name="_WorkoutDetailsPartial" model="workoutViewModel" />

                            <input asp-for="Workouts[i].Id" type="hidden" />
                            <input asp-for="Workouts[i].Date" type="hidden" />
                            <input asp-for="Workouts[i].PlannedDistance" type="hidden" />
                            <input asp-for="Workouts[i].PlannedDuration" type="hidden" />
                            <input asp-for="Workouts[i].Notes" type="hidden" />
                            <input asp-for="Workouts[i].Status" type="hidden" />
                        }
                        else
                        {
                            <partial name="_WorkoutInputPartial" model="currentWorkout" view-data="workoutViewData" />
                        }
                    </div>
                }
            }

            <div asp-validation-summary="ModelOnly" class="er"></div>

            <div class="row">
                <button class="btn go" type="submit">Save changes</button>
                <a class="btn" asp-controller="TrainingPlan" asp-action="Details" asp-route-id="@planId">Cancel</a>
            </div>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
