@model EditTrainingPlanFormInputModel
@{
    ViewData["Title"] = "Edit training plan";
}

<main class="container page-content">
    <div>
        <p class="eyebrow-heading">Adjust your journey</p>
        <h1 class="page-title">Edit training plan</h1>
    </div>

    <form asp-controller="TrainingPlan"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post">
        <div class="stack form-page-stack">
            <div class="field-validation-error" asp-validation-summary="ModelOnly"></div>

            <partial name="_TrainingPlanInputPartial" model="Model" />

            <div class="d-flex flex-wrap align-items-center justify-content-between gap-12">
                <h2>Workouts</h2>
                <button class="button" type="button" id="add-workout-btn">
                    + Add workout
                </button>
            </div>

            <div id="no-workouts-message" class="card card--center" @((Model.ExistingWorkouts.Count == 0 && Model.NewWorkouts.Count == 0) ? null : "hidden")>
                <p class="text-muted">No workouts in this plan. Click "+ Add workout" to schedule sessions.</p>
            </div>

            <div id="workouts-container" class="stack" data-new-workouts-prefix="NewWorkouts">
                @for (int i = 0; i < Model.ExistingWorkouts.Count; i++)
                {
                    <div class="card stack workout-input-card" data-is-existing="true">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-12">
                            <div class="flex-row workout-input-header">
                                <span class="index-chip">@(i + 1)</span>
                                <b>Workout @(i + 1)</b>
                            </div>
                            <button class="button button--small button--danger remove-workout-btn" type="button">
                                Remove
                            </button>
                        </div>

                        <partial name="_WorkoutDetailsPartial" model="Model.ExistingWorkouts[i]" />
                        <input type="hidden" name="KeptWorkoutIds" value="@Model.ExistingWorkouts[i].Id" />
                    </div>
                }

                @for (int i = 0; i < Model.NewWorkouts.Count; i++)
                {
                    <partial name="_WorkoutCardPartial" for="NewWorkouts[i]" />
                }
            </div>

            <div class="flex-row">
                <button class="button button--primary" type="submit">Save changes</button>
                <a class="button" asp-controller="TrainingPlan" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
            </div>
        </div>
    </form>

    <template id="workout-card-template">
        <partial name="_WorkoutCardPartial" model="new WorkoutFormInputModel()" />
    </template>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/training-plan-form.js" asp-append-version="true"></script>
}
