@model IEnumerable<TrainingPlanViewModel>
@{
    ViewData["Title"] = "Plans";

    string userName = User.Identity?.Name ?? "swimmer";
    string displayName = userName.Contains("@") ? userName.Split('@')[0] : userName;

    var allTrainingPlanWorkouts = Model
        .SelectMany(p => p.Workouts.Select(w => new { Plan = p, Workout = w }))
        .ToList();

    var todaySession = allTrainingPlanWorkouts
        .FirstOrDefault(x => x.Workout.Date.Date == DateTime.Today && x.Workout.Status == WorkoutStatus.Planned);

    var upcomingSession = todaySession ?? allTrainingPlanWorkouts
        .Where(x => x.Workout.Status == WorkoutStatus.Planned && x.Workout.Date >= DateTime.Today)
        .OrderBy(x => x.Workout.Date)
        .FirstOrDefault();

    var displaySession = upcomingSession ?? allTrainingPlanWorkouts
        .Where(x => x.Workout.Status == WorkoutStatus.Planned)
        .OrderBy(x => x.Workout.Date)
        .FirstOrDefault();

    bool hasUserPlans = Model.Any();
    TrainingPlanViewModel? trainingPlanWithoutWorkouts = Model.FirstOrDefault(p => !p.Workouts.Any());

    int totalCompletedWorkouts = allTrainingPlanWorkouts.Count(x => x.Workout.Status == WorkoutStatus.Completed);
    int totalSkippedWorkouts = allTrainingPlanWorkouts.Count(x => x.Workout.Status == WorkoutStatus.Skipped);
    int dueWorkouts = allTrainingPlanWorkouts.Count(x => x.Workout.Date.Date <= DateTime.Today);
    int completionPercent = dueWorkouts > 0 ? (int)Math.Round((double)totalCompletedWorkouts / dueWorkouts * 100) : 0;

    int totalDistanceSwum = allTrainingPlanWorkouts
        .Where(x => x.Workout.Status == WorkoutStatus.Completed)
        .Sum(x => x.Workout.Result?.ActualDistance ?? x.Workout.PlannedDistance);
}

<main class="wrap pg">
    <div>
        <p class="eb">@DateTime.Today.ToString(DateTimeFormat)</p>
        <h1 style="font-size:56px">Good to see you, @displayName.</h1>
    </div>

    <section class="dash">
        @if (displaySession != null)
        {
            <article class="next">
                <p class="eb">@(todaySession != null ? "Today’s session" : "Next session") · @displaySession.Plan.Name</p>
                <div class="big">
                    <span class="val"><b>@displaySession.Workout.PlannedDistance</b><span>m</span></span>
                    <span class="val"><b>@displaySession.Workout.PlannedDuration</b><span>min</span></span>
                </div>
                @if (!string.IsNullOrWhiteSpace(displaySession.Workout.Notes))
                {
                    <p class="q">“@displaySession.Workout.Notes”</p>
                }
                else
                {
                    <p class="q">“Stay consistent. Enjoy the swim.”</p>
                }
                <div class="row">
                    @if (displaySession.Workout.Date.Date <= DateTime.Today)
                    {
                        <a class="btn go" asp-controller="Workout" asp-action="Complete" asp-route-id="@displaySession.Workout.Id" asp-route-trainingPlanId="@displaySession.Plan.Id">Complete</a>
                        <form asp-controller="Workout" asp-action="Skip" asp-route-id="@displaySession.Workout.Id" asp-route-trainingPlanId="@displaySession.Plan.Id" method="post" style="display:inline;margin:0;">
                            <button class="btn sk" type="submit">Skip</button>
                        </form>
                    }
                    <a class="btn" asp-controller="Workout" asp-action="Edit" asp-route-id="@displaySession.Workout.Id" asp-route-trainingPlanId="@displaySession.Plan.Id">Edit</a>
                </div>
            </article>
        }
        else if (!hasUserPlans)
        {
            <article class="next">
                <p class="eb">Training Dashboard</p>
                <div class="big">
                    <span>Ready to swim?</span>
                </div>
                <p class="q">Create a training plan to start scheduling and logging your sessions.</p>
                <div class="row">
                    <a class="btn go" asp-controller="TrainingPlan" asp-action="Create">Create training plan</a>
                </div>
            </article>
        }
        else if (trainingPlanWithoutWorkouts != null)
        {
            <article class="next">
                <p class="eb">Plan setup · @trainingPlanWithoutWorkouts.Name</p>
                <div class="big">
                    <span>Add workouts</span>
                </div>
                <p class="q">“@trainingPlanWithoutWorkouts.Name” has no workouts scheduled yet.</p>
                <div class="row">
                    <a class="btn go" asp-controller="TrainingPlan" asp-action="Edit" asp-route-id="@trainingPlanWithoutWorkouts.Id">Add workouts</a>
                    <a class="btn" asp-controller="TrainingPlan" asp-action="Details" asp-route-id="@trainingPlanWithoutWorkouts.Id">Details</a>
                </div>
            </article>
        }
        else
        {
            <article class="next">
                <p class="eb">Training Dashboard</p>
                <div class="big">
                    <span>All caught up! 🎉</span>
                </div>
                <p class="q">You’ve completed all scheduled workouts. Rest up or start a new training plan.</p>
                <div class="row">
                    <a class="btn go" asp-controller="TrainingPlan" asp-action="Create">Start new plan</a>
                </div>
            </article>
        }

        <aside class="card ctr">
            <div class="ring" style="--p:@completionPercent"><b>@completionPercent%</b></div>
            <strong>Completion</strong>
            <small>@totalCompletedWorkouts done · @totalSkippedWorkouts skipped of @dueWorkouts due</small>
        </aside>

        <aside class="card ctr">
            <span class="n">@totalDistanceSwum</span>
            <strong>metres swum</strong>
            <small>@totalCompletedWorkouts completed sessions</small>
        </aside>
    </section>

    <div class="row sp">
        <h2>Your plans</h2>
        @if (hasUserPlans)
        {
            <a class="btn dk" asp-controller="TrainingPlan" asp-action="Create">+ New plan</a>
        }
    </div>

    @if (!hasUserPlans)
    {
        <div class="card ctr">
            <p class="mut">No training plans yet. Create your first plan above to get started.</p>
        </div>
    }
    else
    {
        <section class="g2">
            @foreach (TrainingPlanViewModel trainingPlan in Model)
            {
                List<WorkoutViewModel>? workouts = trainingPlan.Workouts.OrderBy(w => w.Date).ToList();
                int trainingPlanCompleted = workouts.Count(w => w.Status == WorkoutStatus.Completed);
                int trainingPlanSkipped = workouts.Count(w => w.Status == WorkoutStatus.Skipped);
                int trainingPlanPlanned = workouts.Count(w => w.Status == WorkoutStatus.Planned);

                bool hasWorkouts = workouts.Any();
                bool allWorkoutsResolved = hasWorkouts && trainingPlanPlanned == 0;
                bool isPlanExpired = trainingPlan.EndDate.Date < DateTime.Today;

                string trainingPlanStatusClass;
                string trainingPlanStatusText;

                if (allWorkoutsResolved)
                {
                    trainingPlanStatusClass = "bd dn";
                    trainingPlanStatusText = "Finished";
                }
                else if (isPlanExpired)
                {
                    trainingPlanStatusClass = "bd";
                    trainingPlanStatusText = "Expired";
                }
                else if (trainingPlan.StartDate.Date > DateTime.Today)
                {
                    trainingPlanStatusClass = "bd";
                    trainingPlanStatusText = "Upcoming";
                }
                else
                {
                    trainingPlanStatusClass = "bd ac";
                    trainingPlanStatusText = "Active";
                }

                <article class="card">
                    <div class="row sp">
                        <div>
                            <h3>@trainingPlan.Name</h3>
                            <p class="mut">@trainingPlan.StartDate.ToString(DateTimeFormat) – @trainingPlan.EndDate.ToString(DateTimeFormat)</p>
                        </div>
                        <span class="@trainingPlanStatusClass">@trainingPlanStatusText</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(trainingPlan.Goal))
                    {
                        <p>@trainingPlan.Goal</p>
                    }
                    else
                    {
                        <p class="mut">No goal specified.</p>
                    }

                    <div class="strip" role="img" aria-label="@trainingPlanCompleted completed, @trainingPlanSkipped skipped, @trainingPlanPlanned planned">
                        @foreach (WorkoutViewModel workout in workouts)
                        {
                            if (workout.Status == WorkoutStatus.Completed)
                            {
                                <i class="d"></i>
                            }
                            else if (workout.Status == WorkoutStatus.Skipped)
                            {
                                <i class="s"></i>
                            }
                            else
                            {
                                <i></i>
                            }
                        }
                    </div>

                    <div class="row sp">
                        <small>@trainingPlanCompleted of @workouts.Count sessions done</small>
                        <a class="btn sm" asp-controller="TrainingPlan" asp-action="Details" asp-route-id="@trainingPlan.Id">Details</a>
                    </div>
                </article>
            }
        </section>
    }
</main>
