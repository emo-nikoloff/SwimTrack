@model AllTrainingPlansPageViewModel
@{
    ViewData["Title"] = "Plans";

    string userName = User.Identity?.Name ?? "swimmer";
    string displayName = userName.Contains("@") ? userName.Split('@')[0] : userName;
}

<main class="container page-content">
    <div>
        <p class="eyebrow-heading">@DateTime.Today.ToString(DateTimeFormat)</p>
        <h1 class="page-title">Good to see you, @displayName.</h1>
    </div>

    <section class="dashboard-grid">
        @if (!Model.HasUserPlans)
        {
            <article class="dashboard-hero-card">
                <header>
                    <p class="eyebrow-heading">Training Dashboard</p>
                </header>
                <div class="metric-large">
                    <span>Ready to swim?</span>
                </div>
                <p class="dashboard-card-quote">Create a training plan to start scheduling and logging your sessions.</p>
                <footer>
                    <a class="button button--primary" asp-controller="TrainingPlan" asp-action="Create">Create training plan</a>
                </footer>
            </article>
        }
        else if (Model.Dashboard.TrainingPlanWithoutWorkouts != null)
        {
            <article class="dashboard-hero-card">
                <header>
                    <p class="eyebrow-heading">Plan setup · @Model.Dashboard.TrainingPlanWithoutWorkouts.Name</p>
                </header>
                <div class="metric-large">
                    <span>Add workouts</span>
                </div>
                <p class="dashboard-card-quote">“@Model.Dashboard.TrainingPlanWithoutWorkouts.Name” has no workouts scheduled yet.</p>
                <footer>
                    <a class="button button--primary" 
                       asp-controller="TrainingPlan" 
                       asp-action="Edit" 
                       asp-route-id="@Model.Dashboard.TrainingPlanWithoutWorkouts.Id">Add workouts</a>
                    <a class="button"
                       asp-controller="TrainingPlan" 
                       asp-action="Details" 
                       asp-route-id="@Model.Dashboard.TrainingPlanWithoutWorkouts.Id">Details</a>
                </footer>
            </article>
        }
        else if (Model.Dashboard.DisplayWorkout != null)
        {
            string? displaySessionLabel = Model.Dashboard.State switch
            {
                WorkoutState.Today => "Today's session",
                WorkoutState.Overdue => $"Overdue · {Model.Dashboard.DisplayWorkout!.Date.ToString(DateTimeFormat)}",
                WorkoutState.Tomorrow => $"Tomorrow · {Model.Dashboard.DisplayWorkout!.Date.ToString(DateTimeFormat)}",
                WorkoutState.Upcoming => $"Next session · {Model.Dashboard.DisplayWorkout!.Date.ToString(DateTimeFormat)}",
                _ => null
            };

            <article class="dashboard-hero-card">
                <header>
                    <p class="eyebrow-heading">@displaySessionLabel · @Model.Dashboard.DisplayWorkoutPlan!.Name</p>
                </header>
                <div class="metric-large">
                    <span class="metric-large-value"><b>@Model.Dashboard.DisplayWorkout!.PlannedDistance</b><span>m</span></span>
                    <span class="metric-large-value"><b>@Model.Dashboard.DisplayWorkout!.PlannedDuration</b><span>min</span></span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Dashboard.DisplayWorkout!.Notes))
                {
                    <p class="dashboard-card-quote">“@Model.Dashboard.DisplayWorkout!.Notes”</p>
                }
                else
                {
                    <p class="dashboard-card-quote">“Stay consistent. Enjoy the swim.”</p>
                }
                <footer>
                    @if (Model.Dashboard.DisplayWorkout!.Date.Date <= DateTime.Today)
                    {
                        <a class="button button--primary" 
                           asp-controller="Workout" 
                           asp-action="Complete" 
                           asp-route-id="@Model.Dashboard.DisplayWorkout!.Id" 
                           asp-route-trainingPlanId="@Model.Dashboard.DisplayWorkoutPlan.Id"
                           asp-route-returnUrl="@Url.Action("All", "TrainingPlan")">Complete</a>
                        <form class="inline-form" 
                              asp-controller="Workout" 
                              asp-action="Skip" 
                              asp-route-id="@Model.Dashboard.DisplayWorkout!.Id" 
                              asp-route-trainingPlanId="@Model.Dashboard.DisplayWorkoutPlan.Id" 
                              asp-route-returnUrl="@Url.Action("All", "TrainingPlan")"
                              method="post">
                            <button class="button button--warning" type="submit">Skip</button>
                        </form>
                    }
                    <a class="button" 
                       asp-controller="Workout" 
                       asp-action="Edit" 
                       asp-route-id="@Model.Dashboard.DisplayWorkout!.Id" 
                       asp-route-trainingPlanId="@Model.Dashboard.DisplayWorkoutPlan.Id"
                       asp-route-returnUrl="@Url.Action("All", "TrainingPlan")">Edit</a>
                </footer>
            </article>
        }
        else
        {
            <article class="dashboard-hero-card">
                <header>
                    <p class="eyebrow-heading">Training Dashboard</p>
                </header>
                <div class="metric-large">
                    <span>All caught up! 🎉</span>
                </div>
                <p class="dashboard-card-quote">You’ve completed all scheduled workouts. Rest up or start a new training plan.</p>
                <footer>
                    <a class="button button--primary" asp-controller="TrainingPlan" asp-action="Create">Start new plan</a>
                </footer>
            </article>
        }

        <aside class="card card--center">
            <div class="progress-ring" style="--p:@Model.Dashboard.CompletionPercentage"><b>@Model.Dashboard.CompletionPercentage%</b></div>
            <strong>Completion</strong>
            <small>@Model.Dashboard.TotalCompletedWorkouts done · @Model.Dashboard.TotalSkippedWorkouts skipped of @Model.Dashboard.DueWorkouts due</small>
        </aside>

        <aside class="card card--center">
            <span class="stat-number">@Model.Dashboard.TotalDistanceSwum</span>
            <strong>metres swum</strong>
            <small>@Model.Dashboard.TotalCompletedWorkouts completed sessions</small>
        </aside>
    </section>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-12">
        <h2>Your plans</h2>
        @if (Model.HasUserPlans)
        {
            <a class="button button--dark" asp-controller="TrainingPlan" asp-action="Create">+ New plan</a>
        }
    </div>

    @if (!Model.HasUserPlans)
    {
        <div class="card card--center">
            <p class="text-muted">No training plans yet. Create your first plan above to get started.</p>
        </div>
    }
    else
    {
        <section class="grid-2-columns">
            @foreach (AllTrainingPlansViewModel trainingPlan in Model.TrainingPlans)
            {
                string statusClass = trainingPlan.Status switch
                {
                    TrainingPlanStatus.Finished => "badge badge--completed",
                    TrainingPlanStatus.Expired => "badge badge--expired",
                    TrainingPlanStatus.Upcoming => "badge badge--upcoming",
                    TrainingPlanStatus.Active => "badge badge--active",
                    _ => "badge"
                };

                <article class="card plan-card">
                    <header>
                        <div>
                            <h3>@trainingPlan.Name</h3>
                            <p class="text-muted">@trainingPlan.StartDate.ToString(DateTimeFormat) – @trainingPlan.EndDate.ToString(DateTimeFormat)</p>
                        </div>
                        <span class="@statusClass">@trainingPlan.StatusText</span>
                    </header>

                    @if (trainingPlan.TrainingGoal != null)
                    {
                        <p class="text-muted">
                            <span>Goal: @trainingPlan.TrainingGoal.Title</span>
                        </p>
                    }
                    else
                    {
                        <p class="text-muted">No goal specified.</p>
                    }

                    @if (trainingPlan.Workouts.Count > 0)
                    {
                        <div class="workout-strip" role="img" aria-label="@trainingPlan.CompletedWorkouts completed, @trainingPlan.SkippedWorkouts skipped, @trainingPlan.PlannedWorkouts planned">
                            @foreach (WorkoutViewModel workout in trainingPlan.Workouts)
                            {
                                if (workout.Status == WorkoutStatus.Completed)
                                {
                                    <i class="workout-strip-item workout-strip-item--completed"></i>
                                }
                                else if (workout.Status == WorkoutStatus.Skipped)
                                {
                                    <i class="workout-strip-item workout-strip-item--skipped"></i>
                                }
                                else
                                {
                                    <i class="workout-strip-item"></i>
                                }
                            }
                        </div>
                    }

                    <footer>
                        <small>@trainingPlan.CompletedWorkouts of @trainingPlan.Workouts.Count sessions done</small>
                        <a class="button button--small" asp-controller="TrainingPlan" asp-action="Details" asp-route-id="@trainingPlan.Id">Details</a>
                    </footer>
                </article>
            }
        </section>
    }
</main>
