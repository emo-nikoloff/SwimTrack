@model IEnumerable<TrainingPlanViewModel>
@{
    ViewData["Title"] = "Plans";

    string userName = User.Identity?.Name ?? "swimmer";
    string displayName = userName.Contains("@") ? userName.Split('@')[0] : userName;

    var allTrainingPlanWorkouts = Model
        .SelectMany(p => p.Workouts.Select(w => new { Plan = p, Workout = w }))
        .ToList();

    var todaySession = allTrainingPlanWorkouts
        .FirstOrDefault(x => x.Workout.Date.Date == DateTime.Today && x.Workout.Status == WorkoutStatus.Planned);

    var overdueSession = todaySession != null ? null : allTrainingPlanWorkouts
        .Where(x => x.Workout.Status == WorkoutStatus.Planned && x.Workout.Date.Date < DateTime.Today)
        .OrderBy(x => x.Workout.Date)
        .FirstOrDefault();

    var upcomingSession = (todaySession ?? overdueSession) != null ? null : allTrainingPlanWorkouts
        .Where(x => x.Workout.Status == WorkoutStatus.Planned && x.Workout.Date.Date > DateTime.Today)
        .OrderBy(x => x.Workout.Date)
        .FirstOrDefault();

    var displaySession = todaySession ?? overdueSession ?? upcomingSession;

    string sessionPrefix = string.Empty;
    if (displaySession != null)
    {
        if (todaySession != null)
        {
            sessionPrefix = "Today’s session";
        }
        else if (overdueSession != null)
        {
            sessionPrefix = $"Overdue · {overdueSession.Workout.Date.ToString(DateTimeFormat)}";
        }
        else if (displaySession.Workout.Date.Date == DateTime.Today.AddDays(1))
        {
            sessionPrefix = $"Tomorrow · {displaySession.Workout.Date.ToString(DateTimeFormat)}";
        }
        else
        {
            sessionPrefix = $"Next session · {displaySession.Workout.Date.ToString(DateTimeFormat)}";
        }
    }

    bool hasUserPlans = Model.Any();
    TrainingPlanViewModel? trainingPlanWithoutWorkouts = Model.FirstOrDefault(p => !p.Workouts.Any());

    int totalCompletedWorkouts = allTrainingPlanWorkouts.Count(x => x.Workout.Status == WorkoutStatus.Completed);
    int totalSkippedWorkouts = allTrainingPlanWorkouts.Count(x => x.Workout.Status == WorkoutStatus.Skipped);
    int dueWorkouts = allTrainingPlanWorkouts.Count(x => x.Workout.Date.Date <= DateTime.Today);
    int completionPercent = dueWorkouts > 0 ? (int)Math.Round((double)totalCompletedWorkouts / dueWorkouts * 100) : 0;

    int totalDistanceSwum = allTrainingPlanWorkouts
        .Where(x => x.Workout.Status == WorkoutStatus.Completed)
        .Sum(x => x.Workout.Result?.ActualDistance ?? x.Workout.PlannedDistance);
}

<main class="container page-content">
    <div>
        <p class="eyebrow-heading">@DateTime.Today.ToString(DateTimeFormat)</p>
        <h1 class="page-title">Good to see you, @displayName.</h1>
    </div>

    <section class="dashboard-grid">
        @if (displaySession != null)
        {
            <article class="dashboard-hero-card">
                <header>
                    <p class="eyebrow-heading">@sessionPrefix · @displaySession.Plan.Name</p>
                </header>
                <div class="metric-large">
                    <span class="metric-large-value"><b>@displaySession.Workout.PlannedDistance</b><span>m</span></span>
                    <span class="metric-large-value"><b>@displaySession.Workout.PlannedDuration</b><span>min</span></span>
                </div>
                @if (!string.IsNullOrWhiteSpace(displaySession.Workout.Notes))
                {
                    <p class="dashboard-card-quote">“@displaySession.Workout.Notes”</p>
                }
                else
                {
                    <p class="dashboard-card-quote">“Stay consistent. Enjoy the swim.”</p>
                }
                <footer>
                    @if (displaySession.Workout.Date.Date <= DateTime.Today)
                    {
                        <a class="button button--primary" asp-controller="Workout" asp-action="Complete" asp-route-id="@displaySession.Workout.Id" asp-route-trainingPlanId="@displaySession.Plan.Id">Complete</a>
                        <form class="inline-form" asp-controller="Workout" asp-action="Skip" asp-route-id="@displaySession.Workout.Id" asp-route-trainingPlanId="@displaySession.Plan.Id" method="post">
                            <button class="button button--warning" type="submit">Skip</button>
                        </form>
                    }
                    <a class="button" asp-controller="Workout" asp-action="Edit" asp-route-id="@displaySession.Workout.Id" asp-route-trainingPlanId="@displaySession.Plan.Id">Edit</a>
                </footer>
            </article>
        }
        else if (!hasUserPlans)
        {
            <article class="dashboard-hero-card">
                <header>
                    <p class="eyebrow-heading">Training Dashboard</p>
                </header>
                <div class="metric-large">
                    <span>Ready to swim?</span>
                </div>
                <p class="dashboard-card-quote">Create a training plan to start scheduling and logging your sessions.</p>
                <footer>
                    <a class="button button--primary" asp-controller="TrainingPlan" asp-action="Create">Create training plan</a>
                </footer>
            </article>
        }
        else if (trainingPlanWithoutWorkouts != null)
        {
            <article class="dashboard-hero-card">
                <header>
                    <p class="eyebrow-heading">Plan setup · @trainingPlanWithoutWorkouts.Name</p>
                </header>
                <div class="metric-large">
                    <span>Add workouts</span>
                </div>
                <p class="dashboard-card-quote">“@trainingPlanWithoutWorkouts.Name” has no workouts scheduled yet.</p>
                <footer>
                    <a class="button button--primary" asp-controller="TrainingPlan" asp-action="Edit" asp-route-id="@trainingPlanWithoutWorkouts.Id">Add workouts</a>
                    <a class="button" asp-controller="TrainingPlan" asp-action="Details" asp-route-id="@trainingPlanWithoutWorkouts.Id">Details</a>
                </footer>
            </article>
        }
        else
        {
            <article class="dashboard-hero-card">
                <header>
                    <p class="eyebrow-heading">Training Dashboard</p>
                </header>
                <div class="metric-large">
                    <span>All caught up! 🎉</span>
                </div>
                <p class="dashboard-card-quote">You’ve completed all scheduled workouts. Rest up or start a new training plan.</p>
                <footer>
                    <a class="button button--primary" asp-controller="TrainingPlan" asp-action="Create">Start new plan</a>
                </footer>
            </article>
        }

        <aside class="card card--center">
            <div class="progress-ring" style="--p:@completionPercent"><b>@completionPercent%</b></div>
            <strong>Completion</strong>
            <small>@totalCompletedWorkouts done · @totalSkippedWorkouts skipped of @dueWorkouts due</small>
        </aside>

        <aside class="card card--center">
            <span class="stat-number">@totalDistanceSwum</span>
            <strong>metres swum</strong>
            <small>@totalCompletedWorkouts completed sessions</small>
        </aside>
    </section>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-12">
        <h2>Your plans</h2>
        @if (hasUserPlans)
        {
            <a class="button button--dark" asp-controller="TrainingPlan" asp-action="Create">+ New plan</a>
        }
    </div>

    @if (!hasUserPlans)
    {
        <div class="card card--center">
            <p class="text-muted">No training plans yet. Create your first plan above to get started.</p>
        </div>
    }
    else
    {
        <section class="grid-2-columns">
            @foreach (TrainingPlanViewModel trainingPlan in Model)
            {
                List<WorkoutViewModel>? workouts = trainingPlan.Workouts.OrderBy(w => w.Date).ToList();
                int trainingPlanCompleted = workouts.Count(w => w.Status == WorkoutStatus.Completed);
                int trainingPlanSkipped = workouts.Count(w => w.Status == WorkoutStatus.Skipped);
                int trainingPlanPlanned = workouts.Count(w => w.Status == WorkoutStatus.Planned);

                bool hasWorkouts = workouts.Any();
                bool allWorkoutsResolved = hasWorkouts && trainingPlanPlanned == 0;
                bool isPlanExpired = trainingPlan.EndDate.Date < DateTime.Today;

                string trainingPlanStatusClass;
                string trainingPlanStatusText;

                if (allWorkoutsResolved)
                {
                    trainingPlanStatusClass = "badge badge--completed";
                    trainingPlanStatusText = "Finished";
                }
                else if (isPlanExpired)
                {
                    trainingPlanStatusClass = "badge badge--expired";
                    trainingPlanStatusText = "Expired";
                }
                else if (trainingPlan.StartDate.Date > DateTime.Today)
                {
                    trainingPlanStatusClass = "badge badge--upcoming";
                    trainingPlanStatusText = "Upcoming";
                }
                else
                {
                    trainingPlanStatusClass = "badge badge--active";
                    trainingPlanStatusText = "Active";
                }

                <article class="card plan-card">
                    <header>
                        <div>
                            <h3>@trainingPlan.Name</h3>
                            <p class="text-muted">@trainingPlan.StartDate.ToString(DateTimeFormat) – @trainingPlan.EndDate.ToString(DateTimeFormat)</p>
                        </div>
                        <span class="@trainingPlanStatusClass">@trainingPlanStatusText</span>
                    </header>

                    @if (!string.IsNullOrWhiteSpace(trainingPlan.Goal))
                    {
                        <p>@trainingPlan.Goal</p>
                    }
                    else
                    {
                        <p class="text-muted">No goal specified.</p>
                    }

                    @if (workouts.Any())
                    {
                        <div class="workout-strip" role="img" aria-label="@trainingPlanCompleted completed, @trainingPlanSkipped skipped, @trainingPlanPlanned planned">
                            @foreach (WorkoutViewModel workout in workouts)
                            {
                                if (workout.Status == WorkoutStatus.Completed)
                                {
                                    <i class="workout-strip-item workout-strip-item--completed"></i>
                                }
                                else if (workout.Status == WorkoutStatus.Skipped)
                                {
                                    <i class="workout-strip-item workout-strip-item--skipped"></i>
                                }
                                else
                                {
                                    <i class="workout-strip-item"></i>
                                }
                            }
                        </div>
                    }

                    <footer>
                        <small>@trainingPlanCompleted of @workouts.Count sessions done</small>
                        <a class="button button--small" asp-controller="TrainingPlan" asp-action="Details" asp-route-id="@trainingPlan.Id">Details</a>
                    </footer>
                </article>
            }
        </section>
    }
</main>
