@model IEnumerable<TrainingPlanViewModel>
@{
    ViewData["Title"] = "Plans";

    string rawName = User.Identity?.Name ?? "";
    string displayName = rawName.Contains("@") ? rawName.Split('@')[0] : rawName;

    var allWorkoutsWithPlan = Model
        .SelectMany(p => p.Workouts.Select(w => new { Plan = p, Workout = w }))
        .ToList();

    var todaySession = allWorkoutsWithPlan
        .FirstOrDefault(x => x.Workout.Date.Date == DateTime.Today && x.Workout.Status == WorkoutStatus.Planned);

    var upcomingSession = todaySession ?? allWorkoutsWithPlan
        .Where(x => x.Workout.Status == WorkoutStatus.Planned && x.Workout.Date >= DateTime.Today)
        .OrderBy(x => x.Workout.Date)
        .FirstOrDefault();

    var displaySession = upcomingSession ?? allWorkoutsWithPlan
        .Where(x => x.Workout.Status == WorkoutStatus.Planned)
        .OrderBy(x => x.Workout.Date)
        .FirstOrDefault();

    int totalCompleted = allWorkoutsWithPlan.Count(x => x.Workout.Status == WorkoutStatus.Completed);
    int totalSkipped = allWorkoutsWithPlan.Count(x => x.Workout.Status == WorkoutStatus.Skipped);
    int dueWorkouts = allWorkoutsWithPlan.Count(x => x.Workout.Date.Date <= DateTime.Today || x.Workout.Status != WorkoutStatus.Planned);
    int completion = dueWorkouts > 0 ? (int)Math.Round((double)totalCompleted / dueWorkouts * 100) : 100;

    int totalDistanceSwum = allWorkoutsWithPlan
        .Where(x => x.Workout.Status == WorkoutStatus.Completed)
        .Sum(x => x.Workout.Result?.ActualDistance ?? x.Workout.PlannedDistance);
}

<main class="wrap pg">
    <div>
        <p class="eb">@DateTime.Today.ToString(DateTimeFormat)</p>
        <h1 style="font-size:56px">Good to see you, @displayName.</h1>
    </div>

    <section class="dash">
        @if (displaySession != null)
        {
            <article class="next">
                <p class="eb">@(todaySession != null ? "Today’s session" : "Next session") · @displaySession.Plan.Name</p>
                <div class="big">
                    <span class="val"><b>@displaySession.Workout.PlannedDistance</b><span>m</span></span>
                    <span class="val"><b>@displaySession.Workout.PlannedDuration</b><span>min</span></span>
                </div>
                @if (!string.IsNullOrWhiteSpace(displaySession.Workout.Notes))
                {
                    <p class="q">“@displaySession.Workout.Notes”</p>
                }
                else
                {
                    <p class="q">“Stay consistent. Enjoy the swim.”</p>
                }
                <div class="row">
                    <a class="btn go" asp-controller="Workout" asp-action="Complete" asp-route-id="@displaySession.Workout.Id" asp-route-trainingPlanId="@displaySession.Plan.Id">Complete</a>
                    <form asp-controller="Workout" asp-action="Skip" asp-route-id="@displaySession.Workout.Id" asp-route-trainingPlanId="@displaySession.Plan.Id" method="post" style="display:inline;margin:0;">
                        <button class="btn sk" type="submit">Skip</button>
                    </form>
                    <a class="btn" asp-controller="Workout" asp-action="Edit" asp-route-id="@displaySession.Workout.Id" asp-route-trainingPlanId="@displaySession.Plan.Id">Edit</a>
                </div>
            </article>
        }
        else
        {
            <article class="next">
                <p class="eb">Training Dashboard</p>
                <div class="big">
                    <span>Ready to swim?</span>
                </div>
                <p class="q">Create a training plan to start scheduling and logging your sessions.</p>
                <div class="row">
                    <a class="btn go" asp-controller="TrainingPlan" asp-action="Create">Create training plan</a>
                </div>
            </article>
        }

        <aside class="card ctr">
            <div class="ring" style="--p:@completion"><b>@completion%</b></div>
            <strong>Completion</strong>
            <small>@totalCompleted of @dueWorkouts due sessions done</small>
        </aside>

        <aside class="card ctr">
            <span class="n">@totalDistanceSwum</span>
            <strong>metres swum</strong>
            <small>@totalCompleted completed sessions</small>
        </aside>
    </section>

    <div class="row sp">
        <h2>Your plans</h2>
        <a class="btn dk" asp-controller="TrainingPlan" asp-action="Create">Create training plan</a>
    </div>

    <section class="g2">
        @foreach (TrainingPlanViewModel plan in Model)
        {
            List<WorkoutViewModel>? workouts = plan.Workouts.OrderBy(w => w.Date).ToList();
            int planDone = workouts.Count(w => w.Status == WorkoutStatus.Completed);
            int planSkipped = workouts.Count(w => w.Status == WorkoutStatus.Skipped);
            int planPlanned = workouts.Count(w => w.Status == WorkoutStatus.Planned);

            string badgeClass = "bd";
            string badgeText = "Finished";
            if (plan.StartDate.Date <= DateTime.Today && plan.EndDate.Date >= DateTime.Today)
            {
                badgeClass = "bd ac";
                badgeText = "Active";
            }
            else if (plan.StartDate.Date > DateTime.Today)
            {
                badgeClass = "bd";
                badgeText = "Upcoming";
            }

            <article class="card">
                <div class="row sp">
                    <div>
                        <h3>@plan.Name</h3>
                        <p class="mut">@plan.StartDate.ToString(DateTimeFormat) – @plan.EndDate.ToString(DateTimeFormat)</p>
                    </div>
                    <span class="@badgeClass">@badgeText</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(plan.Goal))
                {
                    <p>@plan.Goal</p>
                }
                else
                {
                    <p class="mut">No goal specified.</p>
                }

                <div class="strip" role="img" aria-label="@planDone completed, @planSkipped skipped, @planPlanned planned">
                    @foreach (WorkoutViewModel w in workouts)
                    {
                        if (w.Status == WorkoutStatus.Completed)
                        {
                            <i class="d"></i>
                        }
                        else if (w.Status == WorkoutStatus.Skipped)
                        {
                            <i class="s"></i>
                        }
                        else
                        {
                            <i></i>
                        }
                    }
                </div>

                <div class="row sp">
                    <small>@planDone of @workouts.Count sessions done</small>
                    <a class="btn sm" asp-controller="TrainingPlan" asp-action="Details" asp-route-id="@plan.Id">Details</a>
                </div>
            </article>
        }

        <a class="card new" asp-controller="TrainingPlan" asp-action="Create">+ New training plan</a>
    </section>
</main>
