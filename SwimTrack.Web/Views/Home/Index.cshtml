@{
    ViewData["Title"] = "Home";
}

<main>
    <section class="wrap hero">
        <div class="stack">
            <p class="eb">Swim training journal</p>
            <h1>Plan the swim. Log every length.</h1>
            <p class="lead">SwimTrack turns a goal into a block of sessions, then shows how the water really went.</p>
            <div class="row">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <a class="btn dk" asp-controller="TrainingPlan" asp-action="All">Check your plans</a>
                    <a class="btn go" asp-controller="TrainingPlan" asp-action="Create">Create training plan</a>
                }
                else
                {
                    <a class="btn dk" asp-area="Identity" asp-page="/Account/Register">Start your journey</a>
                    <a class="btn" asp-area="Identity" asp-page="/Account/Login">I have an account</a>
                }
            </div>
            <div class="rope"></div>
            <div class="row">
                <span class="bd">Planned</span>
                <span class="bd dn">Completed</span>
                <span class="bd sk">Skipped</span>
                <small>Every session has a state.</small>
            </div>
        </div>
        <div class="pool" role="img" aria-label="A pool seen from above with five lanes">
            <div class="ln"><b>1</b></div>
            <div class="ln"><b>2</b></div>
            <div class="ln"><b>3</b></div>
            <div class="ln"><b>4</b></div>
            <div class="ln"><b>5</b></div>
            <div class="tag">
                <span class="eb">Today’s session</span>
                <strong>1500 m · 45 min</strong>
            </div>
        </div>
    </section>

    <section class="wrap how">
        <div>
            <p class="eb">How it works</p>
            <h2>Three moves per session</h2>
        </div>
        <div class="g3">
            <article class="card">
                <span class="num">01</span>
                <h3>Plan</h3>
                <p class="mut">Name the block, set the dates and the goal, then add sessions with distance, duration and notes.</p>
                <span class="bd" style="justify-self:start">Planned</span>
            </article>
            <article class="card">
                <span class="num">02</span>
                <h3>Swim</h3>
                <p class="mut">Log what really happened: actual metres, minutes and how it felt.</p>
                <span class="bd dn" style="justify-self:start">Completed</span>
            </article>
            <article class="card">
                <span class="num">03</span>
                <h3>Adjust</h3>
                <p class="mut">Missed a day? Skip it, then plan it again when the week allows.</p>
                <span class="bd sk" style="justify-self:start">Skipped</span>
            </article>
        </div>
    </section>

    <section class="wrap">
        <div class="band">
            <h2 style="max-width:12em">Your next length starts with a plan.</h2>
            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <a class="btn go" asp-controller="TrainingPlan" asp-action="Create">Create your first plan</a>
            }
            else
            {
                <a class="btn go" asp-area="Identity" asp-page="/Account/Register">Create your first plan</a>
            }
        </div>
    </section>
</main>
