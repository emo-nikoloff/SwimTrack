@{
    ViewData["Title"] = "Home";
}

<main>
    <section class="container hero-section">
        <div class="stack">
            <p class="eyebrow-heading">Swim training journal</p>
            <h1>Plan the swim. Log every length.</h1>
            <p class="text-lead">SwimTrack turns a goal into a block of sessions, then shows how the water really went.</p>
            <div class="flex-row">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <a class="button button--primary" asp-controller="TrainingPlan" asp-action="All">Go to your plans</a>
                }
                else
                {
                    <a class="button button--dark" asp-area="Identity" asp-page="/Account/Register">Start your journey</a>
                    <a class="button" asp-area="Identity" asp-page="/Account/Login">I have an account</a>
                }
            </div>
            <div class="lane-rope-divider"></div>
            <div class="flex-row">
                <span class="badge badge--planned">Planned</span>
                <span class="badge badge--completed">Completed</span>
                <span class="badge badge--skipped">Skipped</span>
                <small>Every session has a state.</small>
            </div>
        </div>
        <div class="pool-visual" role="img" aria-label="A pool seen from above with five lanes">
            <div class="pool-lane"><b>1</b></div>
            <div class="pool-lane"><b>2</b></div>
            <div class="pool-lane"><b>3</b></div>
            <div class="pool-lane"><b>4</b></div>
            <div class="pool-lane"><b>5</b></div>
            <div class="pool-tag">
                <span class="eyebrow-heading">Today’s session</span>
                <strong>1500 m · 45 min</strong>
            </div>
        </div>
    </section>

    <section class="container how-it-works-section">
        <div>
            <p class="eyebrow-heading">How it works</p>
            <h2>Three moves per session</h2>
        </div>
        <div class="grid-3-columns">
            <article class="card">
                <header>
                    <span class="step-number">01</span>
                    <h3>Plan</h3>
                </header>
                <p class="text-muted">Name the block, set the dates and the goal, then add sessions with distance, duration and notes.</p>
                <footer>
                    <span class="badge badge--planned">Planned</span>
                </footer>
            </article>
            <article class="card">
                <header>
                    <span class="step-number">02</span>
                    <h3>Swim</h3>
                </header>
                <p class="text-muted">Log what really happened: actual metres, minutes and how it felt.</p>
                <footer>
                    <span class="badge badge--completed">Completed</span>
                </footer>
            </article>
            <article class="card">
                <header>
                    <span class="step-number">03</span>
                    <h3>Adjust</h3>
                </header>
                <p class="text-muted">Missed a day? Skip it, then plan it again when the week allows.</p>
                <footer>
                    <span class="badge badge--skipped">Skipped</span>
                </footer>
            </article>
        </div>
    </section>

    @if (!(User.Identity?.IsAuthenticated ?? false))
    {
        <section class="container">
            <div class="cta-banner">
                <h2 style="max-width:12em">Your next length starts with a plan.</h2>
                <a class="button button--primary" asp-area="Identity" asp-page="/Account/Register">Create your first plan</a>
            </div>
        </section>
    }
</main>
