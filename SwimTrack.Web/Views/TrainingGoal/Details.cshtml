@model TrainingGoalDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<main class="container page-content">
    <a class="text-muted" asp-controller="TrainingGoal" asp-action="All">← Back to goals</a>

    <section class="d-flex flex-wrap align-items-start justify-content-between gap-32">
        <div class="stack plan-details-intro">
            <p class="eyebrow-heading">Training goal</p>
            <h1 class="plan-title">@Model.Title</h1>
            <p class="text-muted">@Model.StartDate.ToString(DateTimeFormat) – @Model.EndDate.ToString(DateTimeFormat)</p>
            <div class="flex-row">
                <a class="button button--dark" asp-controller="TrainingGoal" asp-action="Edit" asp-route-id="@Model.Id">Edit goal</a>
            </div>
        </div>

        <div class="card plan-progress-card">
            <div class="stack plan-progress-details">
                <span class="stat-number">@Model.TargetDistance m</span>
                <small>target distance</small>
            </div>
        </div>
    </section>

    <section class="card card--horizontal">
        <div>
            <h3>Remove this goal</h3>
            <small>This goal will be permanently deleted.</small>
        </div>
        <button class="button button--danger" type="button" popovertarget="rm">Remove</button>
        <div class="popover-dialog" id="rm" popover="">
            <h3>Remove “@Model.Title”?</h3>
            <p class="text-muted remove-plan-warning">This cannot be undone.</p>
            <div class="flex-row">
                <form class="inline-form" asp-controller="TrainingGoal" asp-action="Remove" asp-route-id="@Model.Id" method="post">
                    <button class="button button--danger" type="submit">Yes, remove</button>
                </form>
                <button class="button" type="button" popovertarget="rm" popovertargetaction="hide">Keep it</button>
            </div>
        </div>
    </section>
</main>
